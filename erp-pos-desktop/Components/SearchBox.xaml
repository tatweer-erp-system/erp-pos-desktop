<UserControl x:Class="TatweerPOS.Components.SearchBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             x:Name="Root">

    <Border x:Name="SearchBorder"
            Background="{StaticResource InputBg}"
            BorderBrush="{StaticResource InputBorder}"
            BorderThickness="1.5"
            CornerRadius="10"
            Height="44">

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="44"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Search icon -->
            <materialDesign:PackIcon x:Name="SearchIcon"
                                     Kind="Magnify"
                                     Width="20" Height="20"
                                     Foreground="{StaticResource TextMuted}"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"/>

            <!-- Text input -->
            <TextBox x:Name="SearchInput"
                     Grid.Column="1"
                     Background="Transparent"
                     BorderThickness="0"
                     Foreground="{StaticResource TextPrimary}"
                     CaretBrush="{StaticResource PrimaryBrush}"
                     SelectionBrush="{StaticResource PrimaryBrush}"
                     FontSize="14"
                     VerticalContentAlignment="Center"
                     TextChanged="OnTextChanged"
                     GotFocus="OnInputGotFocus"
                     LostFocus="OnInputLostFocus"
                     PreviewKeyDown="OnInputPreviewKeyDown"/>

            <!-- Placeholder text -->
            <TextBlock x:Name="PlaceholderText"
                       Grid.Column="1"
                       Text="{StaticResource str_SearchPlaceholder}"
                       FontSize="14"
                       Foreground="{StaticResource TextMuted}"
                       VerticalAlignment="Center"
                       IsHitTestVisible="False"/>

            <!-- Clear button (visible when text exists) -->
            <Button x:Name="ClearBtn"
                    Grid.Column="2"
                    Width="36" Height="36"
                    Margin="0,0,4,0"
                    Visibility="Collapsed"
                    Cursor="Hand"
                    Click="OnClearClick"
                    ToolTip="{StaticResource str_Clear}">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="Transparent"
                                            CornerRadius="6">
                                        <materialDesign:PackIcon Kind="Close"
                                                                 Width="16" Height="16"
                                                                 Foreground="{StaticResource TextMuted}"
                                                                 HorizontalAlignment="Center"
                                                                 VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>

            <!-- Barcode mode indicator -->
            <materialDesign:PackIcon x:Name="BarcodeIcon"
                                     Grid.Column="2"
                                     Kind="Barcode"
                                     Width="18" Height="18"
                                     Foreground="{StaticResource SuccessBrush}"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     Margin="0,0,10,0"
                                     Visibility="Collapsed"/>
        </Grid>
    </Border>
</UserControl>
