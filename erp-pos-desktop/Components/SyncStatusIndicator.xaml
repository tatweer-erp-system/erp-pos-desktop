<UserControl x:Class="TatweerPOS.Components.SyncStatusIndicator"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             x:Name="Root">

    <StackPanel Orientation="Horizontal"
                VerticalAlignment="Center">

        <!-- Status dot with pulse animation for Pending -->
        <Grid Width="12" Height="12" Margin="0,0,6,0">
            <!-- Pulse ring (only visible during Pending) -->
            <Ellipse x:Name="PulseRing"
                     Width="12" Height="12"
                     Opacity="0"
                     RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Ellipse.RenderTransform>
            </Ellipse>

            <!-- Main dot -->
            <Ellipse x:Name="StatusDot"
                     Width="8" Height="8"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"/>
        </Grid>

        <!-- Status icon -->
        <materialDesign:PackIcon x:Name="StatusIcon"
                                 Width="16" Height="16"
                                 Margin="0,0,4,0"
                                 VerticalAlignment="Center"/>

        <!-- Status text -->
        <TextBlock x:Name="StatusText"
                   FontSize="12"
                   Foreground="{StaticResource TextSecondary}"
                   VerticalAlignment="Center"/>

        <!-- Tooltip on the whole control -->
        <StackPanel.ToolTip>
            <TextBlock x:Name="TooltipText"/>
        </StackPanel.ToolTip>
    </StackPanel>
</UserControl>
