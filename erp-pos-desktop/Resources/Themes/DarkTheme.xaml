<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════════════════════════════════════════════ -->
    <!-- TatweerPOS Dark Theme                                   -->
    <!-- ═══════════════════════════════════════════════════════ -->

    <!-- Window & Surface Backgrounds -->
    <SolidColorBrush x:Key="WindowBg"       Color="#080A12" />
    <SolidColorBrush x:Key="SurfaceBg"      Color="#0F1219" />
    <SolidColorBrush x:Key="CardBg"         Color="#111827" />
    <SolidColorBrush x:Key="CardHoverBg"    Color="#1A2235" />

    <!-- Input Controls -->
    <SolidColorBrush x:Key="InputBg"           Color="#0F1523" />
    <SolidColorBrush x:Key="InputBorder"       Color="#1E2D45" />
    <SolidColorBrush x:Key="InputBorderFocus"  Color="#6366F1" />

    <!-- Layout Chrome -->
    <SolidColorBrush x:Key="DividerBrush"  Color="#1A2236" />
    <SolidColorBrush x:Key="SidebarBg"     Color="#080A12" />
    <SolidColorBrush x:Key="TopBarBg"      Color="#0F1219" />

    <!-- Typography -->
    <SolidColorBrush x:Key="TextPrimary"    Color="#F8FAFC" />
    <SolidColorBrush x:Key="TextSecondary"  Color="#94A3B8" />
    <SolidColorBrush x:Key="TextMuted"      Color="#475569" />

    <!-- Accent / Brand -->
    <SolidColorBrush x:Key="AccentPrimary"      Color="#6366F1" />
    <SolidColorBrush x:Key="AccentPrimaryHover"  Color="#818CF8" />
    <SolidColorBrush x:Key="AccentSecondary"     Color="#8B5CF6" />

    <!-- Status -->
    <SolidColorBrush x:Key="SuccessBrush"   Color="#22C55E" />
    <SolidColorBrush x:Key="WarningBrush"   Color="#F59E0B" />
    <SolidColorBrush x:Key="ErrorBrush"     Color="#EF4444" />
    <SolidColorBrush x:Key="InfoBrush"      Color="#3B82F6" />

    <!-- Buttons -->
    <SolidColorBrush x:Key="ButtonPrimaryBg"        Color="#6366F1" />
    <SolidColorBrush x:Key="ButtonPrimaryHoverBg"    Color="#818CF8" />
    <SolidColorBrush x:Key="ButtonPrimaryText"       Color="#FFFFFF" />
    <SolidColorBrush x:Key="ButtonSecondaryBg"       Color="#1E293B" />
    <SolidColorBrush x:Key="ButtonSecondaryHoverBg"  Color="#334155" />
    <SolidColorBrush x:Key="ButtonSecondaryText"     Color="#F8FAFC" />
    <SolidColorBrush x:Key="ButtonDangerBg"          Color="#DC2626" />
    <SolidColorBrush x:Key="ButtonDangerHoverBg"     Color="#EF4444" />
    <SolidColorBrush x:Key="ButtonDangerText"        Color="#FFFFFF" />

    <!-- Scrollbar -->
    <SolidColorBrush x:Key="ScrollbarTrack"  Color="#0F1219" />
    <SolidColorBrush x:Key="ScrollbarThumb"  Color="#1E293B" />

    <!-- DataGrid / Table -->
    <SolidColorBrush x:Key="TableHeaderBg"       Color="#0F1219" />
    <SolidColorBrush x:Key="TableRowAltBg"       Color="#0C0F18" />
    <SolidColorBrush x:Key="TableRowHoverBg"     Color="#1A2235" />
    <SolidColorBrush x:Key="TableRowSelectedBg"  Color="#1E2D45" />

    <!-- Overlay / Modal -->
    <SolidColorBrush x:Key="OverlayBg"  Color="#000000" Opacity="0.6" />
    <SolidColorBrush x:Key="ModalBg"    Color="#111827" />

    <!-- Badge -->
    <SolidColorBrush x:Key="BadgeBg"    Color="#6366F1" />
    <SolidColorBrush x:Key="BadgeText"  Color="#FFFFFF" />

    <!-- Tooltip -->
    <SolidColorBrush x:Key="TooltipBg"    Color="#1E293B" />
    <SolidColorBrush x:Key="TooltipText"  Color="#F8FAFC" />

</ResourceDictionary>
