<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Color tokens per CLAUDE.md Color Palette.
        Rule #2: NEVER hardcode hex values — always use {StaticResource}.
    -->

    <!-- ===== Dark Theme Backgrounds ===== -->
    <SolidColorBrush x:Key="WindowBg"         Color="#080A12"/>
    <SolidColorBrush x:Key="SurfaceBg"        Color="#0F1219"/>
    <SolidColorBrush x:Key="CardBg"           Color="#111827"/>
    <SolidColorBrush x:Key="CardHoverBg"      Color="#1A2235"/>
    <SolidColorBrush x:Key="InputBg"          Color="#0F1523"/>
    <SolidColorBrush x:Key="InputBorder"      Color="#1E2D45"/>
    <SolidColorBrush x:Key="InputBorderFocus" Color="#6366F1"/>
    <SolidColorBrush x:Key="DividerBrush"     Color="#1A2236"/>
    <SolidColorBrush x:Key="SidebarBg"        Color="#080A12"/>
    <SolidColorBrush x:Key="TopBarBg"         Color="#0F1219"/>

    <!-- ===== Semantic Colors (same in both themes per CLAUDE.md) ===== -->
    <SolidColorBrush x:Key="PrimaryBrush"     Color="#6366F1"/>
    <SolidColorBrush x:Key="PrimaryDarkBrush" Color="#4F46E5"/>
    <SolidColorBrush x:Key="TealAccent"       Color="#0EA5E9"/>
    <SolidColorBrush x:Key="SuccessBrush"     Color="#10B981"/>
    <SolidColorBrush x:Key="ErrorBrush"       Color="#EF4444"/>
    <SolidColorBrush x:Key="WarningBrush"     Color="#F59E0B"/>
    <SolidColorBrush x:Key="InfoBrush"        Color="#0EA5E9"/>

    <!-- ===== Text Colors ===== -->
    <SolidColorBrush x:Key="TextPrimary"      Color="#F8FAFC"/>
    <SolidColorBrush x:Key="TextSecondary"    Color="#94A3B8"/>
    <SolidColorBrush x:Key="TextMuted"        Color="#475569"/>
    <SolidColorBrush x:Key="TextAccent"       Color="#6366F1"/>

    <!-- ===== PrimaryGradient: #6366F1 -> #8B5CF6 -> #0EA5E9 (diagonal) ===== -->
    <LinearGradientBrush x:Key="PrimaryGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#6366F1" Offset="0"/>
        <GradientStop Color="#8B5CF6" Offset="0.5"/>
        <GradientStop Color="#0EA5E9" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="RightPanelGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#0D1020" Offset="0"/>
        <GradientStop Color="#111827" Offset="0.4"/>
        <GradientStop Color="#0F172A" Offset="1"/>
    </LinearGradientBrush>

    <RadialGradientBrush x:Key="GlowBrush" GradientOrigin="0.5,0.5">
        <GradientStop Color="#6366F130" Offset="0"/>
        <GradientStop Color="#6366F100" Offset="1"/>
    </RadialGradientBrush>

    <!-- ===== Error panel ===== -->
    <SolidColorBrush x:Key="ErrorBgBrush"      Color="#15EF4444"/>
    <SolidColorBrush x:Key="ErrorBorderBrush"   Color="#40EF4444"/>

    <!-- ===== Feature pill backgrounds ===== -->
    <SolidColorBrush x:Key="PrimaryPillBg"      Color="#206366F1"/>
    <SolidColorBrush x:Key="PrimaryPillBorder"   Color="#406366F1"/>
    <SolidColorBrush x:Key="TealPillBg"          Color="#200EA5E9"/>
    <SolidColorBrush x:Key="TealPillBorder"      Color="#400EA5E9"/>
    <SolidColorBrush x:Key="SuccessPillBg"       Color="#2010B981"/>
    <SolidColorBrush x:Key="SuccessPillBorder"   Color="#4010B981"/>

</ResourceDictionary>
