<Window x:Class="TatweerPOS.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:converters="clr-namespace:TatweerPOS.Converters"
        xmlns:components="clr-namespace:TatweerPOS.Components"
        xmlns:vm="clr-namespace:TatweerPOS.ViewModels"
        xmlns:pages="clr-namespace:TatweerPOS.Views.Pages"
        mc:Ignorable="d"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        Width="1440" Height="900"
        MinWidth="1024" MinHeight="700"
        ResizeMode="CanResize"
        Title="Tatweer POS"
        PreviewMouseMove="Window_Activity"
        PreviewKeyDown="Window_Activity">

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>
        <converters:InverseBoolConverter x:Key="InverseBool"/>

        <!-- Page DataTemplates: map each ViewModel to its View -->
        <DataTemplate DataType="{x:Type vm:POSViewModel}">
            <pages:POSPage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:OrdersViewModel}">
            <pages:OrdersPage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:InventoryViewModel}">
            <pages:InventoryPage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CustomersViewModel}">
            <pages:CustomersPage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TablesViewModel}">
            <pages:TablesPage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:KitchenViewModel}">
            <pages:KitchenPage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:EmployeesViewModel}">
            <pages:EmployeesPage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SuppliersViewModel}">
            <pages:SuppliersPage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReportsViewModel}">
            <pages:ReportsPage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <pages:SettingsPage/>
        </DataTemplate>

        <!-- Fallback for placeholder pages -->
        <DataTemplate DataType="{x:Type vm:PlaceholderPageViewModel}">
            <Border Background="{StaticResource SurfaceBg}" Margin="24">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="HammerWrench"
                                             Width="64" Height="64"
                                             Foreground="{StaticResource TextMuted}"
                                             HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding PageName}"
                               FontSize="24" FontWeight="Bold"
                               Foreground="{StaticResource TextSecondary}"
                               HorizontalAlignment="Center" Margin="0,16,0,4"/>
                    <TextBlock Text="This page is under construction"
                               FontSize="14"
                               Foreground="{StaticResource TextMuted}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <!-- Main border with shadow -->
    <Border CornerRadius="12" Background="{StaticResource WindowBg}" ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="40" Opacity="0.8" ShadowDepth="0"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>  <!-- Title bar -->
                <RowDefinition Height="*"/>   <!-- Main content -->
            </Grid.RowDefinitions>

            <!-- ═══════════════════════════════════════════════════════════ -->
            <!-- CUSTOM TITLE BAR                                           -->
            <!-- ═══════════════════════════════════════════════════════════ -->
            <Border Grid.Row="0" Background="{StaticResource SurfaceBg}"
                    MouseDown="TitleBar_MouseDown">
                <Grid Margin="16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- App Logo + Name -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="18" Height="18" CornerRadius="4"
                                Background="{StaticResource PrimaryGradient}">
                            <TextBlock Text="T" FontSize="9" FontWeight="Bold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{StaticResource str_AppName}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondary}"
                                   Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Window Controls -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource TitleBarButtonStyle}" Click="MinimizeButton_Click">
                            <materialDesign:PackIcon Kind="WindowMinimize" Width="14" Height="14"/>
                        </Button>
                        <Button Style="{StaticResource TitleBarButtonStyle}" Click="MaximizeButton_Click" Margin="4,0,0,0">
                            <materialDesign:PackIcon x:Name="MaximizeIcon" Kind="WindowMaximize" Width="14" Height="14"/>
                        </Button>
                        <Button Style="{StaticResource CloseButtonStyle}" Click="CloseButton_Click" Margin="4,0,0,0">
                            <materialDesign:PackIcon Kind="Close" Width="14" Height="14"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══════════════════════════════════════════════════════════ -->
            <!-- MAIN LAYOUT: Sidebar + Content                             -->
            <!-- ═══════════════════════════════════════════════════════════ -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <!-- Sidebar: 240px expanded, 60px collapsed -->
                    <ColumnDefinition x:Name="SidebarColumn" Width="240"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ═══════════════════════════════════════════════════════ -->
                <!-- SIDEBAR                                                 -->
                <!-- ═══════════════════════════════════════════════════════ -->
                <Border Grid.Column="0" Background="{StaticResource SidebarBg}"
                        BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,1,0">
                    <DockPanel>
                        <!-- Sidebar Header: Logo -->
                        <Border DockPanel.Dock="Top" Padding="16,16,16,12">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="36" Height="36" CornerRadius="10"
                                        Background="{StaticResource PrimaryGradient}">
                                    <TextBlock Text="T" FontSize="16" FontWeight="Bold" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{StaticResource str_AppName}" FontSize="16" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimary}"
                                           Margin="12,0,0,0" VerticalAlignment="Center"
                                           Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </Border>

                        <!-- Divider -->
                        <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource DividerBrush}" Margin="12,0"/>

                        <!-- Bottom Buttons: Lock + Logout + Collapse Toggle -->
                        <StackPanel DockPanel.Dock="Bottom" Margin="8,0,8,12">
                            <!-- Divider -->
                            <Border Height="1" Background="{StaticResource DividerBrush}" Margin="4,8"/>

                            <!-- Lock Button -->
                            <Button Style="{StaticResource TitleBarButtonStyle}"
                                    Width="Auto" Height="40"
                                    HorizontalAlignment="Stretch"
                                    Command="{Binding LockScreenCommand}"
                                    ToolTip="{StaticResource str_EnterPin}"
                                    Cursor="Hand">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="8,0">
                                    <materialDesign:PackIcon Kind="Lock" Width="20" Height="20"
                                                             Foreground="{StaticResource TextMuted}"
                                                             VerticalAlignment="Center"/>
                                    <TextBlock Text="{StaticResource str_EnterPin}" FontSize="13"
                                               Foreground="{StaticResource TextSecondary}"
                                               Margin="12,0,0,0" VerticalAlignment="Center"
                                               Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                            </Button>

                            <!-- Logout Button -->
                            <Button Style="{StaticResource TitleBarButtonStyle}"
                                    Width="Auto" Height="40"
                                    HorizontalAlignment="Stretch"
                                    Command="{Binding LogoutCommand}"
                                    ToolTip="{StaticResource str_SignOut}"
                                    Cursor="Hand" Margin="0,2,0,0">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="8,0">
                                    <materialDesign:PackIcon Kind="Logout" Width="20" Height="20"
                                                             Foreground="{StaticResource ErrorBrush}"
                                                             VerticalAlignment="Center"/>
                                    <TextBlock Text="{StaticResource str_SignOut}" FontSize="13"
                                               Foreground="{StaticResource ErrorBrush}"
                                               Margin="12,0,0,0" VerticalAlignment="Center"
                                               Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                            </Button>

                            <!-- Collapse Toggle -->
                            <Button Style="{StaticResource TitleBarButtonStyle}"
                                    Width="Auto" Height="36"
                                    HorizontalAlignment="Stretch"
                                    Command="{Binding ToggleSidebarCommand}"
                                    ToolTip="{StaticResource str_Collapse}"
                                    Cursor="Hand" Margin="0,4,0,0">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="8,0">
                                    <materialDesign:PackIcon x:Name="CollapseIcon"
                                                             Kind="ChevronDoubleLeft" Width="20" Height="20"
                                                             Foreground="{StaticResource TextMuted}"
                                                             VerticalAlignment="Center"
                                                             RenderTransformOrigin="0.5,0.5">
                                        <materialDesign:PackIcon.RenderTransform>
                                            <RotateTransform x:Name="CollapseIconRotation" Angle="0"/>
                                        </materialDesign:PackIcon.RenderTransform>
                                    </materialDesign:PackIcon>
                                    <TextBlock Text="{StaticResource str_Collapse}" FontSize="12"
                                               Foreground="{StaticResource TextMuted}"
                                               Margin="12,0,0,0" VerticalAlignment="Center"
                                               Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Navigation Items -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Margin="0,8,0,0">
                            <ItemsControl x:Name="NavItemsControl"
                                          ItemsSource="{Binding NavigationItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button x:Name="NavBtn"
                                                Style="{StaticResource TitleBarButtonStyle}"
                                                Width="Auto" Height="44"
                                                HorizontalAlignment="Stretch"
                                                Margin="8,1"
                                                Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding PageName}"
                                                Cursor="Hand">
                                            <Grid HorizontalAlignment="Stretch">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <materialDesign:PackIcon Grid.Column="0"
                                                                         Kind="{Binding Icon}"
                                                                         Width="22" Height="22"
                                                                         Margin="10,0,0,0"
                                                                         VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Name}"
                                                           FontSize="13" FontWeight="Medium"
                                                           Margin="12,0,0,0"
                                                           VerticalAlignment="Center"
                                                           Visibility="{Binding DataContext.IsSidebarExpanded, Converter={StaticResource BoolToVis}, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- ═══════════════════════════════════════════════════════ -->
                <!-- RIGHT SIDE: Top Bar + Content                          -->
                <!-- ═══════════════════════════════════════════════════════ -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="56"/>  <!-- Top bar -->
                        <RowDefinition Height="*"/>   <!-- Content -->
                    </Grid.RowDefinitions>

                    <!-- ═══════════════════════════════════════════════════ -->
                    <!-- TOP BAR                                             -->
                    <!-- ═══════════════════════════════════════════════════ -->
                    <Border Grid.Row="0" Background="{StaticResource TopBarBg}"
                            BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1">
                        <Grid Margin="20,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>  <!-- Page title -->
                                <ColumnDefinition Width="*"/>     <!-- Search -->
                                <ColumnDefinition Width="Auto"/>  <!-- Actions -->
                            </Grid.ColumnDefinitions>

                            <!-- Page Title -->
                            <TextBlock Grid.Column="0"
                                       x:Name="PageTitleText"
                                       Text="{Binding CurrentPageTitle}"
                                       FontSize="20" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimary}"
                                       VerticalAlignment="Center"/>

                            <!-- Search Box -->
                            <Border Grid.Column="1"
                                    Background="{StaticResource InputBg}"
                                    BorderBrush="{StaticResource InputBorder}"
                                    BorderThickness="1" CornerRadius="10"
                                    Height="38" MaxWidth="360"
                                    Margin="24,0"
                                    VerticalAlignment="Center">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Grid.Column="0"
                                                             Kind="Magnify"
                                                             Width="18" Height="18"
                                                             Foreground="{StaticResource TextMuted}"
                                                             VerticalAlignment="Center"
                                                             Margin="12,0,0,0"/>
                                    <TextBox Grid.Column="1"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Foreground="{StaticResource TextPrimary}"
                                             FontSize="13"
                                             VerticalContentAlignment="Center"
                                             Padding="8,0"
                                             materialDesign:HintAssist.Hint="{StaticResource str_SearchPlaceholder}"
                                             materialDesign:HintAssist.HintOpacity="0.4"/>
                                </Grid>
                            </Border>

                            <!-- Right Actions -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">

                                <!-- Sync Status Indicator -->
                                <components:SyncStatusIndicator x:Name="SyncIndicator"
                                                                 Margin="0,0,12,0"
                                                                 VerticalAlignment="Center"/>

                                <!-- Theme Toggle -->
                                <components:ThemeToggleButton IsDarkTheme="{Binding IsDarkTheme, Mode=TwoWay}"
                                                              Margin="0,0,8,0"/>

                                <!-- Language Toggle -->
                                <components:LanguageToggle SelectedLanguage="{Binding SelectedLanguage, Mode=TwoWay}"
                                                           Margin="0,0,12,0"/>

                                <!-- Notification Bell -->
                                <Button Style="{StaticResource TitleBarButtonStyle}"
                                        Width="36" Height="36"
                                        ToolTip="Notifications"
                                        Cursor="Hand"
                                        Margin="0,0,12,0">
                                    <Grid>
                                        <materialDesign:PackIcon Kind="BellOutline"
                                                                 Width="20" Height="20"
                                                                 Foreground="{StaticResource TextSecondary}"/>
                                        <!-- Badge (visible when count > 0) -->
                                        <Border CornerRadius="7"
                                                Width="14" Height="14"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Top"
                                                Margin="0,-2,-2,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{StaticResource ErrorBrush}"/>
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding NotificationCount}" Value="0">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding NotificationCount}"
                                                       FontSize="8" FontWeight="Bold"
                                                       Foreground="White"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                </Button>

                                <!-- User Avatar + Info -->
                                <Border Background="{StaticResource CardBg}"
                                        CornerRadius="10" Padding="8,4"
                                        Cursor="Hand">
                                    <StackPanel Orientation="Horizontal">
                                        <!-- Avatar Circle -->
                                        <Border Width="32" Height="32" CornerRadius="16"
                                                Background="{StaticResource PrimaryGradient}">
                                            <TextBlock Text="{Binding UserInitials}"
                                                       FontSize="11" FontWeight="Bold" Foreground="White"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <!-- Name + Role -->
                                        <StackPanel Margin="8,0,4,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding UserName}"
                                                       FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimary}"/>
                                            <TextBlock Text="{Binding UserRole}"
                                                       FontSize="10"
                                                       Foreground="{StaticResource TextMuted}"/>
                                        </StackPanel>

                                        <materialDesign:PackIcon Kind="ChevronDown"
                                                                 Width="16" Height="16"
                                                                 Foreground="{StaticResource TextMuted}"
                                                                 VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ═══════════════════════════════════════════════════ -->
                    <!-- CONTENT AREA                                        -->
                    <!-- ═══════════════════════════════════════════════════ -->
                    <Border Grid.Row="1" Background="{StaticResource SurfaceBg}">
                        <ContentControl x:Name="ContentArea"
                                        Content="{Binding CurrentPage}"/>
                    </Border>
                </Grid>
            </Grid>

            <!-- ═══════════════════════════════════════════════════════════ -->
            <!-- PIN LOCK OVERLAY                                           -->
            <!-- ═══════════════════════════════════════════════════════════ -->
            <Border Grid.Row="0" Grid.RowSpan="2"
                    x:Name="PinLockOverlay"
                    Visibility="{Binding IsPinLocked, Converter={StaticResource BoolToVis}}"
                    CornerRadius="12">
                <Border.Background>
                    <SolidColorBrush Color="#080A12" Opacity="0.95"/>
                </Border.Background>

                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Background="{StaticResource CardBg}"
                            CornerRadius="20" Padding="48,40"
                            BorderBrush="{StaticResource DividerBrush}" BorderThickness="1"
                            Width="380">
                        <Border.Effect>
                            <DropShadowEffect Color="#6366F1" BlurRadius="40" Opacity="0.15" ShadowDepth="0"/>
                        </Border.Effect>

                        <StackPanel HorizontalAlignment="Center">
                            <!-- Lock Icon -->
                            <Border Width="72" Height="72" CornerRadius="36"
                                    Background="{StaticResource PrimaryPillBg}"
                                    HorizontalAlignment="Center">
                                <materialDesign:PackIcon Kind="Lock"
                                                         Width="32" Height="32"
                                                         Foreground="{StaticResource PrimaryBrush}"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <!-- User Name -->
                            <TextBlock Text="{Binding UserName}"
                                       FontSize="20" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimary}"
                                       HorizontalAlignment="Center" Margin="0,20,0,4"/>

                            <TextBlock Text="{StaticResource str_EnterPin}"
                                       FontSize="13"
                                       Foreground="{StaticResource TextSecondary}"
                                       HorizontalAlignment="Center" Margin="0,0,0,24"/>

                            <!-- PIN Input -->
                            <PasswordBox x:Name="PinInput"
                                         Style="{StaticResource DarkPasswordStyle}"
                                         MaxLength="4"
                                         HorizontalAlignment="Stretch"
                                         Height="48"
                                         Padding="14,0"
                                         HorizontalContentAlignment="Center"
                                         FontSize="24"
                                         PasswordChanged="PinInput_PasswordChanged">
                                <PasswordBox.RenderTransform>
                                    <TranslateTransform/>
                                </PasswordBox.RenderTransform>
                            </PasswordBox>

                            <!-- Error Message -->
                            <TextBlock x:Name="PinErrorText"
                                       Text="{Binding PinErrorMessage}"
                                       FontSize="12"
                                       Foreground="{StaticResource ErrorBrush}"
                                       HorizontalAlignment="Center"
                                       Margin="0,12,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PinErrorMessage}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- Lockout countdown -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                        Margin="0,8,0,0"
                                        Visibility="{Binding IsPinLockout, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{StaticResource str_LockedFor}" FontSize="12"
                                           Foreground="{StaticResource WarningBrush}"/>
                                <TextBlock Text=" " FontSize="12"/>
                                <TextBlock Text="{Binding PinLockoutCountdown}" FontSize="12"
                                           Foreground="{StaticResource WarningBrush}" FontWeight="Bold"/>
                                <TextBlock Text=" " FontSize="12"/>
                                <TextBlock Text="{StaticResource str_Seconds}" FontSize="12"
                                           Foreground="{StaticResource WarningBrush}"/>
                            </StackPanel>

                            <!-- Unlock Button -->
                            <Button Style="{StaticResource PrimaryButtonStyle}"
                                    Margin="0,24,0,0" Height="44"
                                    Click="UnlockButton_Click"
                                    IsEnabled="{Binding IsPinLockout, Converter={StaticResource InverseBool}}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <materialDesign:PackIcon Kind="LockOpenVariant" Width="18" Height="18"
                                                             Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Unlock" FontSize="14" FontWeight="Bold"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Switch User link -->
                            <Button Style="{StaticResource LinkButtonStyle}"
                                    Content="{StaticResource str_SignOut}"
                                    Command="{Binding LogoutCommand}"
                                    HorizontalAlignment="Center"
                                    Margin="0,16,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
