<UserControl x:Class="TatweerPOS.Views.Pages.SuppliersPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:components="clr-namespace:TatweerPOS.Components">

    <Grid Background="{StaticResource WindowBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══ Header Section ═══ -->
        <Border x:Name="HeaderSection" Grid.Row="0" Padding="24,20,24,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Title Row -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="TruckDelivery" Width="28" Height="28"
                                                 Foreground="{StaticResource PrimaryBrush}"
                                                 VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <TextBlock Text="{StaticResource str_Suppliers}"
                                   FontSize="24" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimary}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Add Supplier Button -->
                    <Button Grid.Column="1"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Height="40" Padding="20,0"
                            Click="OnAddSupplierClick">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Plus" Width="18" Height="18"
                                                     VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{StaticResource str_AddSupplier}"
                                       VerticalAlignment="Center" FontSize="13"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Stats Row -->
                <UniformGrid Grid.Row="1" Columns="2" Margin="0,0,0,16">
                    <!-- Total -->
                    <Border Background="{StaticResource CardBg}" CornerRadius="10"
                            Padding="16,12" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="{StaticResource str_Total}"
                                       FontSize="12" Foreground="{StaticResource TextMuted}"/>
                            <TextBlock x:Name="TotalSuppliersText" Text="0"
                                       FontSize="22" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimary}"/>
                        </StackPanel>
                    </Border>
                    <!-- Active -->
                    <Border Background="{StaticResource CardBg}" CornerRadius="10"
                            Padding="16,12" Margin="8,0,0,0">
                        <StackPanel>
                            <TextBlock Text="{StaticResource str_Active}"
                                       FontSize="12" Foreground="{StaticResource TextMuted}"/>
                            <TextBlock x:Name="ActiveSuppliersText" Text="0"
                                       FontSize="22" FontWeight="Bold"
                                       Foreground="{StaticResource SuccessBrush}"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>
            </Grid>
        </Border>

        <!-- ═══ Filters Row ═══ -->
        <Border x:Name="FiltersRow" Grid.Row="1" Padding="24,0,24,16">
            <components:SearchBox x:Name="SupplierSearchBox"/>
        </Border>

        <!-- ═══ Loading State ═══ -->
        <StackPanel x:Name="LoadingState" Grid.Row="2" Visibility="Collapsed"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
            <components:LoadingSkeleton SkeletonHeight="60" SkeletonWidth="700" Margin="0,0,0,8"/>
            <components:LoadingSkeleton SkeletonHeight="60" SkeletonWidth="700" Margin="0,0,0,8"/>
            <components:LoadingSkeleton SkeletonHeight="60" SkeletonWidth="700"/>
        </StackPanel>

        <!-- ═══ Content Area ═══ -->
        <Grid x:Name="ContentArea" Grid.Row="2" Margin="24,0,24,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="DetailColumn" Width="0"/>
            </Grid.ColumnDefinitions>

            <!-- Suppliers Table -->
            <Border Grid.Column="0" Background="{StaticResource SurfaceBg}"
                    CornerRadius="12" Padding="4">
                <DataGrid x:Name="SuppliersGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="None"
                          Background="Transparent"
                          Foreground="{StaticResource TextPrimary}"
                          BorderThickness="0"
                          RowBackground="{StaticResource SurfaceBg}"
                          AlternatingRowBackground="{StaticResource CardBg}"
                          FontSize="13"
                          SelectionMode="Single"
                          SelectionChanged="OnSupplierSelected"
                          CanUserSortColumns="True">

                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="{StaticResource CardBg}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Padding" Value="14,10"/>
                            <Setter Property="BorderThickness" Value="0"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="14,10"/>
                            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border Padding="{TemplateBinding Padding}"
                                                Background="{TemplateBinding Background}">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{StaticResource CardHoverBg}"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.CellStyle>

                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Cursor" Value="Hand"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{StaticResource CardHoverBg}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{StaticResource str_SupplierName}"
                                            Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="{StaticResource str_ContactPerson}"
                                            Binding="{Binding Contact}" Width="*"/>
                        <DataGridTextColumn Header="{StaticResource str_Email}"
                                            Binding="{Binding Email}" Width="*"/>
                        <DataGridTextColumn Header="{StaticResource str_Phone}"
                                            Binding="{Binding Phone}" Width="120"/>
                        <DataGridTextColumn Header="{StaticResource str_PaymentTerms}"
                                            Binding="{Binding PaymentTerms}" Width="120"/>
                        <DataGridTextColumn Header="{StaticResource str_TotalOrders}"
                                            Binding="{Binding TotalOrders}" Width="80"/>
                        <DataGridTemplateColumn Header="{StaticResource str_Status}" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="4" Padding="8,3"
                                            HorizontalAlignment="Left"
                                            Background="{Binding IsActive, Converter={StaticResource StatusToColor}}">
                                        <TextBlock FontSize="11" FontWeight="SemiBold"
                                                   Foreground="White">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter Property="Text" Value="{StaticResource str_Active}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                            <Setter Property="Text" Value="{StaticResource str_Inactive}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Empty State -->
            <components:EmptyState x:Name="SuppliersEmptyState"
                                   Icon="TruckDeliveryOutline"
                                   Title="{StaticResource str_NoSuppliers}"
                                   Visibility="Collapsed"/>

            <!-- ═══ Detail Panel ═══ -->
            <Border x:Name="DetailPanel" Grid.Column="1"
                    Background="{StaticResource SurfaceBg}"
                    CornerRadius="12" Margin="16,0,0,0"
                    Padding="20" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Close -->
                        <Button HorizontalAlignment="Right"
                                Style="{StaticResource TitleBarButtonStyle}"
                                Click="OnCloseDetailClick">
                            <materialDesign:PackIcon Kind="Close" Width="18" Height="18"/>
                        </Button>

                        <!-- Supplier Icon -->
                        <Border Width="64" Height="64" CornerRadius="32"
                                Background="{StaticResource PrimaryBrush}"
                                Margin="0,0,0,16" HorizontalAlignment="Center">
                            <materialDesign:PackIcon Kind="TruckDelivery"
                                                     Width="28" Height="28"
                                                     Foreground="White"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock x:Name="DetailName" FontSize="20" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimary}"
                                   HorizontalAlignment="Center" Margin="0,0,0,16"/>

                        <Border Height="1" Background="{StaticResource DividerBrush}"
                                Margin="0,0,0,16"/>

                        <!-- Detail Fields -->
                        <TextBlock Text="{StaticResource str_ContactPerson}" FontSize="12"
                                   Foreground="{StaticResource TextMuted}" Margin="0,0,0,4"/>
                        <TextBlock x:Name="DetailContact" FontSize="14"
                                   Foreground="{StaticResource TextPrimary}" Margin="0,0,0,12"/>

                        <TextBlock Text="{StaticResource str_Email}" FontSize="12"
                                   Foreground="{StaticResource TextMuted}" Margin="0,0,0,4"/>
                        <TextBlock x:Name="DetailEmail" FontSize="14"
                                   Foreground="{StaticResource TextPrimary}" Margin="0,0,0,12"/>

                        <TextBlock Text="{StaticResource str_Phone}" FontSize="12"
                                   Foreground="{StaticResource TextMuted}" Margin="0,0,0,4"/>
                        <TextBlock x:Name="DetailPhone" FontSize="14"
                                   Foreground="{StaticResource TextPrimary}" Margin="0,0,0,12"/>

                        <TextBlock Text="{StaticResource str_Address}" FontSize="12"
                                   Foreground="{StaticResource TextMuted}" Margin="0,0,0,4"/>
                        <TextBlock x:Name="DetailAddress" FontSize="14"
                                   Foreground="{StaticResource TextPrimary}" Margin="0,0,0,12"
                                   TextWrapping="Wrap"/>

                        <TextBlock Text="{StaticResource str_PaymentTerms}" FontSize="12"
                                   Foreground="{StaticResource TextMuted}" Margin="0,0,0,4"/>
                        <TextBlock x:Name="DetailPaymentTerms" FontSize="14"
                                   Foreground="{StaticResource TextPrimary}" Margin="0,0,0,12"/>

                        <TextBlock Text="{StaticResource str_TotalOrders}" FontSize="12"
                                   Foreground="{StaticResource TextMuted}" Margin="0,0,0,4"/>
                        <TextBlock x:Name="DetailTotalOrders" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,12"/>

                        <TextBlock Text="{StaticResource str_Notes}" FontSize="12"
                                   Foreground="{StaticResource TextMuted}" Margin="0,0,0,4"/>
                        <TextBlock x:Name="DetailNotes" FontSize="13"
                                   Foreground="{StaticResource TextSecondary}" Margin="0,0,0,20"
                                   TextWrapping="Wrap"/>

                        <Border Height="1" Background="{StaticResource DividerBrush}"
                                Margin="0,0,0,16"/>

                        <!-- Action Buttons -->
                        <Button Content="{StaticResource str_EditSupplier}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Height="36" FontSize="13" Margin="0,0,0,8"
                                Click="OnEditSupplierClick"/>

                        <Button x:Name="ToggleActiveBtn"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Height="36" FontSize="13"
                                Click="OnToggleActiveClick"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
