<UserControl x:Class="TatweerPOS.Views.Pages.CustomersPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:components="clr-namespace:TatweerPOS.Components"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1200">

    <Grid Background="{StaticResource SurfaceBg}" Margin="24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header + stats -->
            <RowDefinition Height="Auto"/>  <!-- Filters -->
            <RowDefinition Height="*"/>     <!-- Content -->
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- HEADER — Title + Stats Cards                                   -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <StackPanel x:Name="HeaderSection" Grid.Row="0" Margin="0,0,0,16">
            <!-- Title row -->
            <Grid Margin="0,0,0,16">
                <TextBlock Text="{StaticResource str_Customers}"
                           FontSize="24" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimary}"
                           VerticalAlignment="Center"/>
                <!-- Add customer button (role-based) -->
                <Button Style="{StaticResource PrimaryButtonStyle}"
                        Height="40" HorizontalAlignment="Right"
                        Command="{Binding AddCustomerCommand}"
                        Visibility="{Binding CanEditCustomers, Converter={StaticResource BoolToVisibility}}"
                        Cursor="Hand">
                    <StackPanel Orientation="Horizontal" Margin="16,0">
                        <materialDesign:PackIcon Kind="AccountPlus" Width="18" Height="18"
                                                 Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{StaticResource str_AddCustomer}"
                                   FontSize="13" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Stats cards -->
            <StackPanel Orientation="Horizontal">
                <!-- Total Customers -->
                <Border Background="{StaticResource CardBg}"
                        CornerRadius="12" Padding="20,14"
                        Margin="0,0,12,0" MinWidth="180">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="40" Height="40" CornerRadius="10"
                                Background="{StaticResource PrimaryBrush}" Opacity="0.15">
                            <materialDesign:PackIcon Kind="AccountGroup" Width="20" Height="20"
                                                     Foreground="{StaticResource PrimaryBrush}"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding TotalCustomerCount}"
                                       FontSize="20" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimary}"/>
                            <TextBlock Text="{StaticResource str_TotalCustomers}"
                                       FontSize="11" Foreground="{StaticResource TextMuted}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Active Customers -->
                <Border Background="{StaticResource CardBg}"
                        CornerRadius="12" Padding="20,14"
                        Margin="0,0,12,0" MinWidth="180">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="40" Height="40" CornerRadius="10"
                                Background="{StaticResource SuccessBrush}" Opacity="0.15">
                            <materialDesign:PackIcon Kind="AccountCheck" Width="20" Height="20"
                                                     Foreground="{StaticResource SuccessBrush}"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ActiveCustomerCount}"
                                       FontSize="20" FontWeight="Bold"
                                       Foreground="{StaticResource SuccessBrush}"/>
                            <TextBlock Text="{StaticResource str_ActiveCustomers}"
                                       FontSize="11" Foreground="{StaticResource TextMuted}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Loyalty Points -->
                <Border Background="{StaticResource CardBg}"
                        CornerRadius="12" Padding="20,14"
                        MinWidth="180">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="40" Height="40" CornerRadius="10"
                                Background="{StaticResource WarningBrush}" Opacity="0.15">
                            <materialDesign:PackIcon Kind="Star" Width="20" Height="20"
                                                     Foreground="{StaticResource WarningBrush}"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding TotalLoyaltyPoints}"
                                       FontSize="20" FontWeight="Bold"
                                       Foreground="{StaticResource WarningBrush}"/>
                            <TextBlock Text="{StaticResource str_LoyaltyPoints}"
                                       FontSize="11" Foreground="{StaticResource TextMuted}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- FILTERS ROW                                                    -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <Grid x:Name="FiltersRow" Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="360"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <components:SearchBox Grid.Column="0"
                                  SearchText="{Binding SearchText, Mode=TwoWay}"
                                  Placeholder="{StaticResource str_SearchPlaceholder}"/>

            <!-- Tier filter tabs -->
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <RadioButton Content="{StaticResource str_AllTiers}"
                             GroupName="TierFilter"
                             IsChecked="{Binding IsAllTier}"
                             Style="{StaticResource MaterialDesignTabRadioButtonStyle}"
                             Foreground="{StaticResource TextSecondary}"
                             Margin="0,0,4,0"/>
                <RadioButton Content="{StaticResource str_Platinum}"
                             GroupName="TierFilter"
                             IsChecked="{Binding IsPlatinumFilter}"
                             Style="{StaticResource MaterialDesignTabRadioButtonStyle}"
                             Foreground="{StaticResource TextSecondary}"
                             Margin="0,0,4,0"/>
                <RadioButton Content="{StaticResource str_Gold}"
                             GroupName="TierFilter"
                             IsChecked="{Binding IsGoldFilter}"
                             Style="{StaticResource MaterialDesignTabRadioButtonStyle}"
                             Foreground="{StaticResource TextSecondary}"
                             Margin="0,0,4,0"/>
                <RadioButton Content="{StaticResource str_Silver}"
                             GroupName="TierFilter"
                             IsChecked="{Binding IsSilverFilter}"
                             Style="{StaticResource MaterialDesignTabRadioButtonStyle}"
                             Foreground="{StaticResource TextSecondary}"
                             Margin="0,0,4,0"/>
                <RadioButton Content="{StaticResource str_Bronze}"
                             GroupName="TierFilter"
                             IsChecked="{Binding IsBronzeFilter}"
                             Style="{StaticResource MaterialDesignTabRadioButtonStyle}"
                             Foreground="{StaticResource TextSecondary}"/>
            </StackPanel>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- CONTENT — Customer Grid + Detail Panel                         -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <Grid x:Name="ContentArea" Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>  <!-- Detail panel -->
            </Grid.ColumnDefinitions>

            <!-- Loading skeleton -->
            <WrapPanel Grid.Column="0"
                       Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
                <components:LoadingSkeleton SkeletonWidth="280" SkeletonHeight="120"
                                             SkeletonCornerRadius="12" Margin="0,0,12,12"/>
                <components:LoadingSkeleton SkeletonWidth="280" SkeletonHeight="120"
                                             SkeletonCornerRadius="12" Margin="0,0,12,12"/>
                <components:LoadingSkeleton SkeletonWidth="280" SkeletonHeight="120"
                                             SkeletonCornerRadius="12" Margin="0,0,12,12"/>
                <components:LoadingSkeleton SkeletonWidth="280" SkeletonHeight="120"
                                             SkeletonCornerRadius="12" Margin="0,0,12,12"/>
            </WrapPanel>

            <!-- Empty state -->
            <components:EmptyState Grid.Column="0"
                                    Icon="AccountGroupOutline"
                                    Title="{StaticResource str_NoCustomers}"
                                    Subtitle="{StaticResource str_NoResults}"
                                    Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibility}}"/>

            <!-- Customer cards grid -->
            <ScrollViewer Grid.Column="0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding IsLoading, Converter={StaticResource InverseBoolToVisibility}}">
                <ItemsControl ItemsSource="{Binding FilteredCustomers}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Margin="0,0,12,12" Cursor="Hand"
                                    Command="{Binding DataContext.SelectCustomerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}">
                                <Button.Template>
                                    <ControlTemplate>
                                        <Border x:Name="CustomerCard"
                                                Width="280" MinHeight="120"
                                                Background="{StaticResource CardBg}"
                                                BorderBrush="{StaticResource DividerBrush}"
                                                BorderThickness="1"
                                                CornerRadius="12"
                                                Padding="16">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Avatar circle -->
                                                <Border Grid.Column="0"
                                                        Width="48" Height="48"
                                                        CornerRadius="24"
                                                        Background="{StaticResource PrimaryGradient}"
                                                        VerticalAlignment="Top">
                                                    <TextBlock Text="{Binding Initials}"
                                                               FontSize="16" FontWeight="Bold"
                                                               Foreground="White"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Border>

                                                <!-- Customer info -->
                                                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                                    <Grid>
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontSize="14" FontWeight="SemiBold"
                                                                   Foreground="{StaticResource TextPrimary}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <!-- Tier badge -->
                                                        <Border HorizontalAlignment="Right"
                                                                CornerRadius="6" Padding="8,2"
                                                                Background="{Binding Tier, Converter={StaticResource StatusToColor}}">
                                                            <TextBlock Text="{Binding Tier, Converter={StaticResource EnumToString}}"
                                                                       FontSize="9" FontWeight="Bold"
                                                                       Foreground="White"/>
                                                        </Border>
                                                    </Grid>

                                                    <TextBlock Text="{Binding Email}"
                                                               FontSize="11"
                                                               Foreground="{StaticResource TextMuted}"
                                                               TextTrimming="CharacterEllipsis"
                                                               Margin="0,4,0,0"/>

                                                    <Border Height="1" Background="{StaticResource DividerBrush}"
                                                            Margin="0,8"/>

                                                    <Grid>
                                                        <StackPanel Orientation="Horizontal">
                                                            <materialDesign:PackIcon Kind="Star" Width="14" Height="14"
                                                                                     Foreground="{StaticResource WarningBrush}"
                                                                                     VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding LoyaltyPoints}"
                                                                       FontSize="12" FontWeight="SemiBold"
                                                                       Foreground="{StaticResource TextPrimary}"
                                                                       Margin="4,0,0,0"
                                                                       VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding TotalSpent, Converter={StaticResource CurrencyFormat}}"
                                                                   FontSize="12" FontWeight="SemiBold"
                                                                   Foreground="{StaticResource SuccessBrush}"
                                                                   HorizontalAlignment="Right"
                                                                   VerticalAlignment="Center"/>
                                                    </Grid>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="CustomerCard" Property="Background"
                                                        Value="{StaticResource CardHoverBg}"/>
                                                <Setter TargetName="CustomerCard" Property="BorderBrush"
                                                        Value="{StaticResource PrimaryBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Detail panel -->
            <Border Grid.Column="1"
                    Width="340"
                    Background="{StaticResource CardBg}"
                    CornerRadius="12"
                    Margin="16,0,0,0"
                    Padding="20"
                    Visibility="{Binding SelectedCustomer, Converter={StaticResource NullToVisibility}}">
                <DockPanel>
                    <!-- Header -->
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
                        <TextBlock Text="{StaticResource str_Details}"
                                   FontSize="16" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimary}"/>
                        <Button Style="{StaticResource TitleBarButtonStyle}"
                                Width="28" Height="28"
                                HorizontalAlignment="Right"
                                Command="{Binding CloseDetailCommand}"
                                Cursor="Hand">
                            <materialDesign:PackIcon Kind="Close" Width="16" Height="16"
                                                     Foreground="{StaticResource TextMuted}"/>
                        </Button>
                    </Grid>

                    <Border DockPanel.Dock="Top" Height="1"
                            Background="{StaticResource DividerBrush}" Margin="0,0,0,16"/>

                    <!-- Edit button (role-based) -->
                    <Button DockPanel.Dock="Bottom"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Height="40"
                            Command="{Binding EditCustomerCommand}"
                            Visibility="{Binding CanEditCustomers, Converter={StaticResource BoolToVisibility}}"
                            Cursor="Hand" Margin="0,16,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <materialDesign:PackIcon Kind="AccountEdit" Width="18" Height="18"
                                                     Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{StaticResource str_EditCustomer}"
                                       FontSize="13" FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Customer details -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Avatar -->
                            <Border Width="64" Height="64" CornerRadius="32"
                                    Background="{StaticResource PrimaryGradient}"
                                    HorizontalAlignment="Center" Margin="0,0,0,12">
                                <TextBlock Text="{Binding SelectedCustomer.Initials}"
                                           FontSize="22" FontWeight="Bold"
                                           Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <TextBlock Text="{Binding SelectedCustomer.Name}"
                                       FontSize="16" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimary}"
                                       HorizontalAlignment="Center" Margin="0,0,0,16"/>

                            <!-- Info rows -->
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="{StaticResource str_EmailAddress}"
                                           FontSize="12" Foreground="{StaticResource TextMuted}"/>
                                <TextBlock Text="{Binding SelectedCustomer.Email}"
                                           FontSize="12" Foreground="{StaticResource TextPrimary}"
                                           HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="{StaticResource str_Phone}"
                                           FontSize="12" Foreground="{StaticResource TextMuted}"/>
                                <TextBlock Text="{Binding SelectedCustomer.Phone}"
                                           FontSize="12" Foreground="{StaticResource TextPrimary}"
                                           HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="{StaticResource str_CustomerTier}"
                                           FontSize="12" Foreground="{StaticResource TextMuted}"/>
                                <TextBlock Text="{Binding SelectedCustomer.Tier, Converter={StaticResource EnumToString}}"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource PrimaryBrush}"
                                           HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="{StaticResource str_LoyaltyPoints}"
                                           FontSize="12" Foreground="{StaticResource TextMuted}"/>
                                <TextBlock Text="{Binding SelectedCustomer.LoyaltyPoints}"
                                           FontSize="12" FontWeight="Bold"
                                           Foreground="{StaticResource WarningBrush}"
                                           HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="{StaticResource str_TotalSpent}"
                                           FontSize="12" Foreground="{StaticResource TextMuted}"/>
                                <TextBlock Text="{Binding SelectedCustomer.TotalSpent, Converter={StaticResource CurrencyFormat}}"
                                           FontSize="12" FontWeight="Bold"
                                           Foreground="{StaticResource SuccessBrush}"
                                           HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="{StaticResource str_JoinDate}"
                                           FontSize="12" Foreground="{StaticResource TextMuted}"/>
                                <TextBlock Text="{Binding SelectedCustomer.JoinDate, StringFormat=dd/MM/yyyy}"
                                           FontSize="12" Foreground="{StaticResource TextPrimary}"
                                           HorizontalAlignment="Right"/>
                            </Grid>

                            <!-- Order history summary -->
                            <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,8,0,12"/>
                            <TextBlock Text="{StaticResource str_PurchaseHistory}"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}"
                                       Margin="0,0,0,8"/>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="{StaticResource str_TotalOrders}"
                                           FontSize="12" Foreground="{StaticResource TextMuted}"/>
                                <TextBlock Text="{Binding SelectedCustomer.TotalOrders}"
                                           FontSize="12" Foreground="{StaticResource TextPrimary}"
                                           HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="{StaticResource str_AverageOrder}"
                                           FontSize="12" Foreground="{StaticResource TextMuted}"/>
                                <TextBlock Text="{Binding SelectedCustomer.AverageOrder, Converter={StaticResource CurrencyFormat}}"
                                           FontSize="12" Foreground="{StaticResource TextPrimary}"
                                           HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
