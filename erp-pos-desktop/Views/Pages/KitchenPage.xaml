<UserControl x:Class="TatweerPOS.Views.Pages.KitchenPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:components="clr-namespace:TatweerPOS.Components">

    <Grid Background="{StaticResource WindowBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══ Header Section ═══ -->
        <Border x:Name="HeaderSection" Grid.Row="0" Padding="24,20,24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Title -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="Stove" Width="28" Height="28"
                                             Foreground="{StaticResource PrimaryBrush}"
                                             VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock Text="{StaticResource str_KitchenDisplay}"
                               FontSize="24" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimary}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Auto-refresh toggle -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{StaticResource str_Refresh}"
                               FontSize="13" Foreground="{StaticResource TextSecondary}"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ToggleButton x:Name="AutoRefreshToggle"
                                  IsChecked="True"
                                  Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                  ToolTip="{StaticResource str_Refresh}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ Loading State ═══ -->
        <StackPanel x:Name="LoadingState" Grid.Row="1" Visibility="Collapsed"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
            <components:LoadingSkeleton SkeletonHeight="200" SkeletonWidth="300" Margin="0,0,0,16"/>
            <TextBlock Text="{StaticResource str_Loading}"
                       FontSize="14" Foreground="{StaticResource TextMuted}"
                       HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- ═══ Content Area — 3-Column Kanban ═══ -->
        <Grid x:Name="ContentArea" Grid.Row="1" Margin="16,0,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ── Column 1: New Orders ── -->
            <Border Grid.Column="0" Background="{StaticResource SurfaceBg}"
                    CornerRadius="12" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Column Header -->
                    <Border Grid.Row="0" Margin="0,0,0,12" Padding="12,10"
                            Background="{StaticResource CardBg}" CornerRadius="8">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="10" Height="10" CornerRadius="5"
                                    Background="{StaticResource WarningBrush}" Margin="0,0,10,0"
                                    VerticalAlignment="Center"/>
                            <TextBlock Text="{StaticResource str_NewOrders}"
                                       FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}"
                                       VerticalAlignment="Center"/>
                            <Border x:Name="NewCountBadge" Margin="10,0,0,0"
                                    Background="{StaticResource WarningBrush}"
                                    CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                                <TextBlock x:Name="NewCountText" Text="0"
                                           FontSize="12" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimary}"
                                           HorizontalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- New Tickets List -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <ItemsControl x:Name="NewTicketsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource CardBg}"
                                                CornerRadius="10" Margin="0,0,0,8"
                                                BorderThickness="0,3,0,0"
                                                BorderBrush="{StaticResource WarningBrush}"
                                                Padding="14,12" Cursor="Hand">
                                            <StackPanel>
                                                <!-- Order Header -->
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding OrderNumber}"
                                                                   FontSize="15" FontWeight="Bold"
                                                                   Foreground="{StaticResource TextPrimary}"/>
                                                        <!-- Order Type Badge -->
                                                        <Border Margin="8,0,0,0" CornerRadius="4"
                                                                Padding="6,2"
                                                                Background="{StaticResource PrimaryBrush}">
                                                            <TextBlock Text="{Binding OrderType, Converter={StaticResource EnumToString}}"
                                                                       FontSize="10" FontWeight="SemiBold"
                                                                       Foreground="White"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <!-- Time Elapsed -->
                                                    <TextBlock Grid.Column="1"
                                                               FontSize="12"
                                                               Foreground="{StaticResource TextMuted}"
                                                               VerticalAlignment="Center">
                                                        <TextBlock.Text>
                                                            <Binding Path="CreatedAt"
                                                                     StringFormat="{}{0:HH:mm}"/>
                                                        </TextBlock.Text>
                                                    </TextBlock>
                                                </Grid>

                                                <!-- Table Number -->
                                                <TextBlock Visibility="{Binding TableNumber, Converter={StaticResource NullToVisibility}}"
                                                           FontSize="12" Foreground="{StaticResource TextSecondary}"
                                                           Margin="0,0,0,6">
                                                    <Run Text="{StaticResource str_TableNumber}"/>
                                                    <Run Text=": "/>
                                                    <Run Text="{Binding TableNumber, Mode=OneWay}"/>
                                                </TextBlock>

                                                <!-- Divider -->
                                                <Border Height="1" Background="{StaticResource DividerBrush}"
                                                        Margin="0,4,0,8"/>

                                                <!-- Items List -->
                                                <ItemsControl ItemsSource="{Binding Items}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,0,0,4">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <Border Width="22" Height="22"
                                                                        CornerRadius="4" Margin="0,0,8,0"
                                                                        Background="{StaticResource SurfaceBg}">
                                                                    <TextBlock Text="{Binding Quantity}"
                                                                               FontSize="11" FontWeight="Bold"
                                                                               Foreground="{StaticResource PrimaryBrush}"
                                                                               HorizontalAlignment="Center"
                                                                               VerticalAlignment="Center"/>
                                                                </Border>
                                                                <StackPanel Grid.Column="1">
                                                                    <TextBlock Text="{Binding Name}"
                                                                               FontSize="13"
                                                                               Foreground="{StaticResource TextPrimary}"/>
                                                                    <TextBlock Text="{Binding Notes}"
                                                                               FontSize="11"
                                                                               Foreground="{StaticResource WarningBrush}"
                                                                               Visibility="{Binding Notes, Converter={StaticResource NullToVisibility}}"
                                                                               FontStyle="Italic"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <!-- Action Button: Start -->
                                                <Button Content="{StaticResource str_Preparing}"
                                                        Style="{StaticResource PrimaryButtonStyle}"
                                                        Height="34" FontSize="13" Margin="0,10,0,0"
                                                        Tag="{Binding Id}"
                                                        Click="OnStartClick"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Empty State for New -->
                            <components:EmptyState x:Name="NewEmptyState"
                                                   Icon="InboxOutline"
                                                   Title="{StaticResource str_NoOrders}"
                                                   Subtitle=""
                                                   Visibility="Collapsed"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- ── Column 2: Preparing ── -->
            <Border Grid.Column="2" Background="{StaticResource SurfaceBg}"
                    CornerRadius="12" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Column Header -->
                    <Border Grid.Row="0" Margin="0,0,0,12" Padding="12,10"
                            Background="{StaticResource CardBg}" CornerRadius="8">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="10" Height="10" CornerRadius="5"
                                    Background="{StaticResource ErrorBrush}" Margin="0,0,10,0"
                                    VerticalAlignment="Center"/>
                            <TextBlock Text="{StaticResource str_Preparing}"
                                       FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}"
                                       VerticalAlignment="Center"/>
                            <Border x:Name="PreparingCountBadge" Margin="10,0,0,0"
                                    Background="{StaticResource ErrorBrush}"
                                    CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                                <TextBlock x:Name="PreparingCountText" Text="0"
                                           FontSize="12" FontWeight="Bold"
                                           Foreground="White"
                                           HorizontalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Preparing Tickets List -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <ItemsControl x:Name="PreparingTicketsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource CardBg}"
                                                CornerRadius="10" Margin="0,0,0,8"
                                                BorderThickness="0,3,0,0"
                                                BorderBrush="{StaticResource ErrorBrush}"
                                                Padding="14,12" Cursor="Hand">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding OrderNumber}"
                                                                   FontSize="15" FontWeight="Bold"
                                                                   Foreground="{StaticResource TextPrimary}"/>
                                                        <Border Margin="8,0,0,0" CornerRadius="4"
                                                                Padding="6,2"
                                                                Background="{StaticResource PrimaryBrush}">
                                                            <TextBlock Text="{Binding OrderType, Converter={StaticResource EnumToString}}"
                                                                       FontSize="10" FontWeight="SemiBold"
                                                                       Foreground="White"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1"
                                                               FontSize="12"
                                                               Foreground="{StaticResource TextMuted}"
                                                               VerticalAlignment="Center">
                                                        <TextBlock.Text>
                                                            <Binding Path="CreatedAt"
                                                                     StringFormat="{}{0:HH:mm}"/>
                                                        </TextBlock.Text>
                                                    </TextBlock>
                                                </Grid>

                                                <TextBlock Visibility="{Binding TableNumber, Converter={StaticResource NullToVisibility}}"
                                                           FontSize="12" Foreground="{StaticResource TextSecondary}"
                                                           Margin="0,0,0,6">
                                                    <Run Text="{StaticResource str_TableNumber}"/>
                                                    <Run Text=": "/>
                                                    <Run Text="{Binding TableNumber, Mode=OneWay}"/>
                                                </TextBlock>

                                                <Border Height="1" Background="{StaticResource DividerBrush}"
                                                        Margin="0,4,0,8"/>

                                                <ItemsControl ItemsSource="{Binding Items}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,0,0,4">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <Border Width="22" Height="22"
                                                                        CornerRadius="4" Margin="0,0,8,0"
                                                                        Background="{StaticResource SurfaceBg}">
                                                                    <TextBlock Text="{Binding Quantity}"
                                                                               FontSize="11" FontWeight="Bold"
                                                                               Foreground="{StaticResource PrimaryBrush}"
                                                                               HorizontalAlignment="Center"
                                                                               VerticalAlignment="Center"/>
                                                                </Border>
                                                                <StackPanel Grid.Column="1">
                                                                    <TextBlock Text="{Binding Name}"
                                                                               FontSize="13"
                                                                               Foreground="{StaticResource TextPrimary}"/>
                                                                    <TextBlock Text="{Binding Notes}"
                                                                               FontSize="11"
                                                                               Foreground="{StaticResource WarningBrush}"
                                                                               Visibility="{Binding Notes, Converter={StaticResource NullToVisibility}}"
                                                                               FontStyle="Italic"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <!-- Action Button: Done -->
                                                <Button Content="{StaticResource str_MarkReady}"
                                                        Style="{StaticResource PrimaryButtonStyle}"
                                                        Height="34" FontSize="13" Margin="0,10,0,0"
                                                        Tag="{Binding Id}"
                                                        Click="OnDoneClick"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <components:EmptyState x:Name="PreparingEmptyState"
                                                   Icon="ChefHat"
                                                   Title="{StaticResource str_NoOrders}"
                                                   Subtitle=""
                                                   Visibility="Collapsed"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- ── Column 3: Ready ── -->
            <Border Grid.Column="4" Background="{StaticResource SurfaceBg}"
                    CornerRadius="12" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Column Header -->
                    <Border Grid.Row="0" Margin="0,0,0,12" Padding="12,10"
                            Background="{StaticResource CardBg}" CornerRadius="8">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="10" Height="10" CornerRadius="5"
                                    Background="{StaticResource SuccessBrush}" Margin="0,0,10,0"
                                    VerticalAlignment="Center"/>
                            <TextBlock Text="{StaticResource str_Ready}"
                                       FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}"
                                       VerticalAlignment="Center"/>
                            <Border x:Name="ReadyCountBadge" Margin="10,0,0,0"
                                    Background="{StaticResource SuccessBrush}"
                                    CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                                <TextBlock x:Name="ReadyCountText" Text="0"
                                           FontSize="12" FontWeight="Bold"
                                           Foreground="White"
                                           HorizontalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Ready Tickets List -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <ItemsControl x:Name="ReadyTicketsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource CardBg}"
                                                CornerRadius="10" Margin="0,0,0,8"
                                                BorderThickness="0,3,0,0"
                                                BorderBrush="{StaticResource SuccessBrush}"
                                                Padding="14,12" Cursor="Hand">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding OrderNumber}"
                                                                   FontSize="15" FontWeight="Bold"
                                                                   Foreground="{StaticResource TextPrimary}"/>
                                                        <Border Margin="8,0,0,0" CornerRadius="4"
                                                                Padding="6,2"
                                                                Background="{StaticResource PrimaryBrush}">
                                                            <TextBlock Text="{Binding OrderType, Converter={StaticResource EnumToString}}"
                                                                       FontSize="10" FontWeight="SemiBold"
                                                                       Foreground="White"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1"
                                                               FontSize="12"
                                                               Foreground="{StaticResource TextMuted}"
                                                               VerticalAlignment="Center">
                                                        <TextBlock.Text>
                                                            <Binding Path="CreatedAt"
                                                                     StringFormat="{}{0:HH:mm}"/>
                                                        </TextBlock.Text>
                                                    </TextBlock>
                                                </Grid>

                                                <TextBlock Visibility="{Binding TableNumber, Converter={StaticResource NullToVisibility}}"
                                                           FontSize="12" Foreground="{StaticResource TextSecondary}"
                                                           Margin="0,0,0,6">
                                                    <Run Text="{StaticResource str_TableNumber}"/>
                                                    <Run Text=": "/>
                                                    <Run Text="{Binding TableNumber, Mode=OneWay}"/>
                                                </TextBlock>

                                                <Border Height="1" Background="{StaticResource DividerBrush}"
                                                        Margin="0,4,0,8"/>

                                                <ItemsControl ItemsSource="{Binding Items}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,0,0,4">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <Border Width="22" Height="22"
                                                                        CornerRadius="4" Margin="0,0,8,0"
                                                                        Background="{StaticResource SurfaceBg}">
                                                                    <TextBlock Text="{Binding Quantity}"
                                                                               FontSize="11" FontWeight="Bold"
                                                                               Foreground="{StaticResource PrimaryBrush}"
                                                                               HorizontalAlignment="Center"
                                                                               VerticalAlignment="Center"/>
                                                                </Border>
                                                                <StackPanel Grid.Column="1">
                                                                    <TextBlock Text="{Binding Name}"
                                                                               FontSize="13"
                                                                               Foreground="{StaticResource TextPrimary}"/>
                                                                    <TextBlock Text="{Binding Notes}"
                                                                               FontSize="11"
                                                                               Foreground="{StaticResource WarningBrush}"
                                                                               Visibility="{Binding Notes, Converter={StaticResource NullToVisibility}}"
                                                                               FontStyle="Italic"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <!-- Action Button: Serve -->
                                                <Button Content="{StaticResource str_MarkServed}"
                                                        Style="{StaticResource PrimaryButtonStyle}"
                                                        Height="34" FontSize="13" Margin="0,10,0,0"
                                                        Tag="{Binding Id}"
                                                        Click="OnServeClick"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <components:EmptyState x:Name="ReadyEmptyState"
                                                   Icon="CheckCircleOutline"
                                                   Title="{StaticResource str_NoOrders}"
                                                   Subtitle=""
                                                   Visibility="Collapsed"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
