<UserControl x:Class="TatweerPOS.Views.Pages.TablesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:components="clr-namespace:TatweerPOS.Components"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1200">

    <Grid Background="{StaticResource SurfaceBg}" Margin="24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header + stats -->
            <RowDefinition Height="Auto"/>  <!-- Floor + Section filters -->
            <RowDefinition Height="*"/>     <!-- Content -->
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- HEADER — Title + Stats Cards                                   -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <StackPanel x:Name="HeaderSection" Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="{StaticResource str_Tables}"
                       FontSize="24" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimary}"
                       Margin="0,0,0,16"/>

            <!-- Stats cards -->
            <StackPanel Orientation="Horizontal">
                <!-- Available -->
                <Border Background="{StaticResource CardBg}"
                        CornerRadius="12" Padding="20,14"
                        Margin="0,0,12,0" MinWidth="170">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="40" Height="40" CornerRadius="10"
                                Background="{StaticResource SuccessBrush}" Opacity="0.15">
                            <materialDesign:PackIcon Kind="CheckCircle" Width="20" Height="20"
                                                     Foreground="{StaticResource SuccessBrush}"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding AvailableCount}"
                                       FontSize="20" FontWeight="Bold"
                                       Foreground="{StaticResource SuccessBrush}"/>
                            <TextBlock Text="{StaticResource str_Available}"
                                       FontSize="11" Foreground="{StaticResource TextMuted}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Occupied -->
                <Border Background="{StaticResource CardBg}"
                        CornerRadius="12" Padding="20,14"
                        Margin="0,0,12,0" MinWidth="170">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="40" Height="40" CornerRadius="10"
                                Background="{StaticResource ErrorBrush}" Opacity="0.15">
                            <materialDesign:PackIcon Kind="AccountMultiple" Width="20" Height="20"
                                                     Foreground="{StaticResource ErrorBrush}"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding OccupiedCount}"
                                       FontSize="20" FontWeight="Bold"
                                       Foreground="{StaticResource ErrorBrush}"/>
                            <TextBlock Text="{StaticResource str_Occupied}"
                                       FontSize="11" Foreground="{StaticResource TextMuted}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Reserved -->
                <Border Background="{StaticResource CardBg}"
                        CornerRadius="12" Padding="20,14"
                        MinWidth="170">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="40" Height="40" CornerRadius="10"
                                Background="{StaticResource WarningBrush}" Opacity="0.15">
                            <materialDesign:PackIcon Kind="CalendarClock" Width="20" Height="20"
                                                     Foreground="{StaticResource WarningBrush}"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ReservedCount}"
                                       FontSize="20" FontWeight="Bold"
                                       Foreground="{StaticResource WarningBrush}"/>
                            <TextBlock Text="{StaticResource str_Reserved}"
                                       FontSize="11" Foreground="{StaticResource TextMuted}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- FILTERS — Floor selector + Section filter                      -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <Grid x:Name="FiltersRow" Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Floor selector -->
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <TextBlock Text="{StaticResource str_Floor}"
                           FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondary}"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"/>
                <RadioButton Content="1"
                             GroupName="Floor"
                             IsChecked="{Binding IsFloor1}"
                             Style="{StaticResource MaterialDesignTabRadioButtonStyle}"
                             Foreground="{StaticResource TextSecondary}"
                             Margin="0,0,4,0"/>
                <RadioButton Content="2"
                             GroupName="Floor"
                             IsChecked="{Binding IsFloor2}"
                             Style="{StaticResource MaterialDesignTabRadioButtonStyle}"
                             Foreground="{StaticResource TextSecondary}"/>
            </StackPanel>

            <!-- Section filter -->
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <TextBlock Text="{StaticResource str_Filter}"
                           FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondary}"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"/>
                <RadioButton Content="{StaticResource str_AllItems}"
                             GroupName="SectionFilter"
                             IsChecked="{Binding IsAllSection}"
                             Style="{StaticResource MaterialDesignTabRadioButtonStyle}"
                             Foreground="{StaticResource TextSecondary}"
                             Margin="0,0,4,0"/>
                <RadioButton Content="{StaticResource str_Indoor}"
                             GroupName="SectionFilter"
                             IsChecked="{Binding IsIndoorFilter}"
                             Style="{StaticResource MaterialDesignTabRadioButtonStyle}"
                             Foreground="{StaticResource TextSecondary}"
                             Margin="0,0,4,0"/>
                <RadioButton Content="{StaticResource str_Outdoor}"
                             GroupName="SectionFilter"
                             IsChecked="{Binding IsOutdoorFilter}"
                             Style="{StaticResource MaterialDesignTabRadioButtonStyle}"
                             Foreground="{StaticResource TextSecondary}"
                             Margin="0,0,4,0"/>
                <RadioButton Content="{StaticResource str_VIP}"
                             GroupName="SectionFilter"
                             IsChecked="{Binding IsVipFilter}"
                             Style="{StaticResource MaterialDesignTabRadioButtonStyle}"
                             Foreground="{StaticResource TextSecondary}"
                             Margin="0,0,4,0"/>
                <RadioButton Content="{StaticResource str_Bar}"
                             GroupName="SectionFilter"
                             IsChecked="{Binding IsBarFilter}"
                             Style="{StaticResource MaterialDesignTabRadioButtonStyle}"
                             Foreground="{StaticResource TextSecondary}"/>
            </StackPanel>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- CONTENT — Table Grid + Detail Panel                            -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <Grid x:Name="ContentArea" Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>  <!-- Detail panel -->
            </Grid.ColumnDefinitions>

            <!-- Loading skeleton -->
            <WrapPanel Grid.Column="0"
                       Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
                <components:LoadingSkeleton SkeletonWidth="160" SkeletonHeight="160"
                                             SkeletonCornerRadius="16" Margin="0,0,16,16"/>
                <components:LoadingSkeleton SkeletonWidth="160" SkeletonHeight="160"
                                             SkeletonCornerRadius="16" Margin="0,0,16,16"/>
                <components:LoadingSkeleton SkeletonWidth="160" SkeletonHeight="160"
                                             SkeletonCornerRadius="16" Margin="0,0,16,16"/>
                <components:LoadingSkeleton SkeletonWidth="160" SkeletonHeight="160"
                                             SkeletonCornerRadius="16" Margin="0,0,16,16"/>
                <components:LoadingSkeleton SkeletonWidth="160" SkeletonHeight="160"
                                             SkeletonCornerRadius="16" Margin="0,0,16,16"/>
                <components:LoadingSkeleton SkeletonWidth="160" SkeletonHeight="160"
                                             SkeletonCornerRadius="16" Margin="0,0,16,16"/>
            </WrapPanel>

            <!-- Empty state -->
            <components:EmptyState Grid.Column="0"
                                    Icon="TableFurniture"
                                    Title="{StaticResource str_NoTables}"
                                    Subtitle="{StaticResource str_NoResults}"
                                    Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibility}}"/>

            <!-- Table cards grid -->
            <ScrollViewer Grid.Column="0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding IsLoading, Converter={StaticResource InverseBoolToVisibility}}">
                <ItemsControl ItemsSource="{Binding FilteredTables}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Margin="0,0,16,16" Cursor="Hand"
                                    Command="{Binding DataContext.SelectTableCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}">
                                <Button.Template>
                                    <ControlTemplate>
                                        <Border x:Name="TableCard"
                                                Width="160" Height="160"
                                                CornerRadius="16"
                                                Padding="16"
                                                BorderThickness="2"
                                                BorderBrush="{Binding Status, Converter={StaticResource StatusToColor}}"
                                                Background="{StaticResource CardBg}"
                                                RenderTransformOrigin="0.5,0.5">
                                            <Border.RenderTransform>
                                                <TranslateTransform Y="0"/>
                                            </Border.RenderTransform>
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <!-- Status indicator dot + table number -->
                                                <Grid Grid.Row="0">
                                                    <!-- Status dot -->
                                                    <Border Width="10" Height="10" CornerRadius="5"
                                                            Background="{Binding Status, Converter={StaticResource StatusToColor}}"
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Center"/>
                                                    <!-- Section badge -->
                                                    <Border CornerRadius="6" Padding="6,2"
                                                            Background="{StaticResource InputBg}"
                                                            HorizontalAlignment="Right">
                                                        <TextBlock Text="{Binding Section, Converter={StaticResource EnumToString}}"
                                                                   FontSize="9"
                                                                   Foreground="{StaticResource TextMuted}"/>
                                                    </Border>
                                                </Grid>

                                                <!-- Table number (large, center) -->
                                                <StackPanel Grid.Row="1"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center">
                                                    <materialDesign:PackIcon Kind="TableFurniture"
                                                                             Width="28" Height="28"
                                                                             Foreground="{Binding Status, Converter={StaticResource StatusToColor}}"
                                                                             HorizontalAlignment="Center"
                                                                             Margin="0,0,0,4"/>
                                                    <TextBlock Text="{Binding Number}"
                                                               FontSize="22" FontWeight="Bold"
                                                               Foreground="{StaticResource TextPrimary}"
                                                               HorizontalAlignment="Center"/>
                                                </StackPanel>

                                                <!-- Bottom info: capacity + waiter -->
                                                <Grid Grid.Row="2">
                                                    <!-- Capacity -->
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                                        <materialDesign:PackIcon Kind="SeatOutline"
                                                                                 Width="14" Height="14"
                                                                                 Foreground="{StaticResource TextMuted}"
                                                                                 VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding Capacity}"
                                                                   FontSize="11"
                                                                   Foreground="{StaticResource TextMuted}"
                                                                   Margin="4,0,0,0"
                                                                   VerticalAlignment="Center"/>
                                                    </StackPanel>

                                                    <!-- Waiter name (if occupied) -->
                                                    <TextBlock Text="{Binding WaiterName}"
                                                               FontSize="10"
                                                               Foreground="{StaticResource TextSecondary}"
                                                               HorizontalAlignment="Right"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"
                                                               MaxWidth="70"
                                                               Visibility="{Binding WaiterName, Converter={StaticResource NullToVisibility}}"/>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="TableCard" Property="Background"
                                                        Value="{StaticResource CardHoverBg}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Detail / Action panel -->
            <Border Grid.Column="1"
                    Width="340"
                    Background="{StaticResource CardBg}"
                    CornerRadius="12"
                    Margin="16,0,0,0"
                    Padding="20"
                    Visibility="{Binding SelectedTable, Converter={StaticResource NullToVisibility}}">
                <DockPanel>
                    <!-- Header -->
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{StaticResource str_TableNumber}"
                                       FontSize="16" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimary}"/>
                            <TextBlock Text="{Binding SelectedTable.Number}"
                                       FontSize="16" FontWeight="Bold"
                                       Foreground="{StaticResource PrimaryBrush}"
                                       Margin="8,0,0,0"/>
                        </StackPanel>
                        <Button Style="{StaticResource TitleBarButtonStyle}"
                                Width="28" Height="28"
                                HorizontalAlignment="Right"
                                Command="{Binding CloseDetailCommand}"
                                Cursor="Hand">
                            <materialDesign:PackIcon Kind="Close" Width="16" Height="16"
                                                     Foreground="{StaticResource TextMuted}"/>
                        </Button>
                    </Grid>

                    <Border DockPanel.Dock="Top" Height="1"
                            Background="{StaticResource DividerBrush}" Margin="0,0,0,16"/>

                    <!-- Action buttons (bottom) -->
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
                        <!-- Change status -->
                        <Button Style="{StaticResource PrimaryButtonStyle}"
                                Height="40" Margin="0,0,0,8"
                                Command="{Binding ChangeTableStatusCommand}"
                                Cursor="Hand">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <materialDesign:PackIcon Kind="SwapHorizontal" Width="18" Height="18"
                                                         Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{StaticResource str_ChangeStatus}"
                                           FontSize="13" FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Assign waiter -->
                        <Button Style="{StaticResource TitleBarButtonStyle}"
                                Width="Auto" Height="40"
                                HorizontalAlignment="Stretch"
                                Command="{Binding AssignWaiterCommand}"
                                Cursor="Hand">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <materialDesign:PackIcon Kind="AccountArrowRight" Width="18" Height="18"
                                                         Foreground="{StaticResource TextSecondary}"
                                                         Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{StaticResource str_AssignWaiter}"
                                           FontSize="13" FontWeight="Medium"
                                           Foreground="{StaticResource TextSecondary}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Table info -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Table visual icon -->
                            <Border Width="72" Height="72" CornerRadius="20"
                                    Background="{Binding SelectedTable.Status, Converter={StaticResource StatusToColor}}"
                                    Opacity="0.15"
                                    HorizontalAlignment="Center" Margin="0,0,0,12">
                                <materialDesign:PackIcon Kind="TableFurniture" Width="36" Height="36"
                                                         Foreground="{Binding SelectedTable.Status, Converter={StaticResource StatusToColor}}"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <!-- Info rows -->
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="{StaticResource str_Status}"
                                           FontSize="12" Foreground="{StaticResource TextMuted}"/>
                                <Border CornerRadius="6" Padding="8,2"
                                        Background="{Binding SelectedTable.Status, Converter={StaticResource StatusToColor}}"
                                        HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding SelectedTable.Status, Converter={StaticResource EnumToString}}"
                                               FontSize="10" FontWeight="Bold"
                                               Foreground="White"/>
                                </Border>
                            </Grid>
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="{StaticResource str_Capacity}"
                                           FontSize="12" Foreground="{StaticResource TextMuted}"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <materialDesign:PackIcon Kind="SeatOutline" Width="14" Height="14"
                                                             Foreground="{StaticResource TextPrimary}"
                                                             VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding SelectedTable.Capacity}"
                                               FontSize="12" Foreground="{StaticResource TextPrimary}"
                                               Margin="4,0,0,0"/>
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="{StaticResource str_Floor}"
                                           FontSize="12" Foreground="{StaticResource TextMuted}"/>
                                <TextBlock Text="{Binding SelectedTable.Floor}"
                                           FontSize="12" Foreground="{StaticResource TextPrimary}"
                                           HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,0,0,10"
                                  Visibility="{Binding SelectedTable.WaiterName, Converter={StaticResource NullToVisibility}}">
                                <TextBlock Text="{StaticResource str_Waiter}"
                                           FontSize="12" Foreground="{StaticResource TextMuted}"/>
                                <TextBlock Text="{Binding SelectedTable.WaiterName}"
                                           FontSize="12" Foreground="{StaticResource TextPrimary}"
                                           HorizontalAlignment="Right"/>
                            </Grid>

                            <!-- Current order info (if occupied) -->
                            <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,8,0,12"
                                    Visibility="{Binding SelectedTable.HasCurrentOrder, Converter={StaticResource BoolToVisibility}}"/>
                            <StackPanel Visibility="{Binding SelectedTable.HasCurrentOrder, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{StaticResource str_CurrentOrder}"
                                           FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}"
                                           Margin="0,0,0,8"/>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="{StaticResource str_OrderNumber}"
                                               FontSize="12" Foreground="{StaticResource TextMuted}"/>
                                    <TextBlock Text="{Binding SelectedTable.CurrentOrderNumber}"
                                               FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource PrimaryBrush}"
                                               HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="{StaticResource str_Total}"
                                               FontSize="12" Foreground="{StaticResource TextMuted}"/>
                                    <TextBlock Text="{Binding SelectedTable.CurrentOrderTotal, Converter={StaticResource CurrencyFormat}}"
                                               FontSize="12" FontWeight="Bold"
                                               Foreground="{StaticResource TextPrimary}"
                                               HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="{StaticResource str_ItemsCount}"
                                               FontSize="12" Foreground="{StaticResource TextMuted}"/>
                                    <TextBlock Text="{Binding SelectedTable.CurrentOrderItemsCount}"
                                               FontSize="12" Foreground="{StaticResource TextPrimary}"
                                               HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
