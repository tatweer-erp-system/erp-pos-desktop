<UserControl x:Class="TatweerPOS.Views.Pages.POSPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:components="clr-namespace:TatweerPOS.Components"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1200">

    <Grid Background="{StaticResource SurfaceBg}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180"/>  <!-- Categories sidebar -->
            <ColumnDefinition Width="*"/>    <!-- Products grid -->
            <ColumnDefinition Width="320"/>  <!-- Cart panel -->
        </Grid.ColumnDefinitions>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- LEFT SIDEBAR — Categories                                      -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <Border x:Name="HeaderSection"
                Grid.Column="0"
                Background="{StaticResource CardBg}"
                BorderBrush="{StaticResource DividerBrush}"
                BorderThickness="0,0,1,0">
            <DockPanel>
                <!-- Categories header -->
                <TextBlock DockPanel.Dock="Top"
                           Text="{StaticResource str_Category}"
                           FontSize="14" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimary}"
                           Margin="16,16,16,12"/>
                <Border DockPanel.Dock="Top" Height="1"
                        Background="{StaticResource DividerBrush}" Margin="12,0"/>

                <!-- Category list -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Margin="0,8,0,0">
                    <ItemsControl ItemsSource="{Binding Categories}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource TitleBarButtonStyle}"
                                        Width="Auto" Height="42"
                                        HorizontalAlignment="Stretch"
                                        Margin="8,1"
                                        Command="{Binding DataContext.SelectCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Cursor="Hand">
                                    <Grid HorizontalAlignment="Stretch">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="4"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Active indicator bar -->
                                        <Border Grid.Column="0" Width="3" CornerRadius="2"
                                                Background="{StaticResource PrimaryBrush}"
                                                Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibility}}"
                                                VerticalAlignment="Stretch"
                                                Margin="0,4"/>

                                        <!-- Category emoji/icon -->
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Emoji}"
                                                   FontSize="16"
                                                   Margin="8,0,0,0"
                                                   VerticalAlignment="Center"/>

                                        <!-- Category name -->
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Name}"
                                                   FontSize="13" FontWeight="Medium"
                                                   Foreground="{StaticResource TextPrimary}"
                                                   Margin="8,0,0,0"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- CENTER — Products Grid                                         -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <Grid x:Name="FiltersRow" Grid.Column="1" Margin="16,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- Search + Order type -->
                <RowDefinition Height="Auto"/>  <!-- Order type selector -->
                <RowDefinition Height="*"/>     <!-- Products grid -->
            </Grid.RowDefinitions>

            <!-- Search box with barcode detection -->
            <components:SearchBox Grid.Row="0"
                                  SearchText="{Binding SearchText, Mode=TwoWay}"
                                  Placeholder="{StaticResource str_ScanBarcode}"
                                  Margin="0,0,0,12"/>

            <!-- Order type selector -->
            <Border Grid.Row="1" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <RadioButton Content="{StaticResource str_DineIn}"
                                 GroupName="OrderType"
                                 IsChecked="{Binding IsDineIn}"
                                 Style="{StaticResource MaterialDesignTabRadioButtonStyle}"
                                 Foreground="{StaticResource TextSecondary}"
                                 Margin="0,0,4,0"/>
                    <RadioButton Content="{StaticResource str_TakeAway}"
                                 GroupName="OrderType"
                                 IsChecked="{Binding IsTakeAway}"
                                 Style="{StaticResource MaterialDesignTabRadioButtonStyle}"
                                 Foreground="{StaticResource TextSecondary}"
                                 Margin="0,0,4,0"/>
                    <RadioButton Content="{StaticResource str_Delivery}"
                                 GroupName="OrderType"
                                 IsChecked="{Binding IsDelivery}"
                                 Style="{StaticResource MaterialDesignTabRadioButtonStyle}"
                                 Foreground="{StaticResource TextSecondary}"
                                 Margin="0,0,4,0"/>
                    <RadioButton Content="{StaticResource str_OnlineOrder}"
                                 GroupName="OrderType"
                                 IsChecked="{Binding IsOnline}"
                                 Style="{StaticResource MaterialDesignTabRadioButtonStyle}"
                                 Foreground="{StaticResource TextSecondary}"/>
                </StackPanel>
            </Border>

            <!-- Products area -->
            <Grid Grid.Row="2">
                <!-- Loading skeleton -->
                <StackPanel Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
                    <WrapPanel>
                        <components:LoadingSkeleton SkeletonWidth="150" SkeletonHeight="160"
                                                     SkeletonCornerRadius="12" Margin="0,0,12,12"/>
                        <components:LoadingSkeleton SkeletonWidth="150" SkeletonHeight="160"
                                                     SkeletonCornerRadius="12" Margin="0,0,12,12"/>
                        <components:LoadingSkeleton SkeletonWidth="150" SkeletonHeight="160"
                                                     SkeletonCornerRadius="12" Margin="0,0,12,12"/>
                        <components:LoadingSkeleton SkeletonWidth="150" SkeletonHeight="160"
                                                     SkeletonCornerRadius="12" Margin="0,0,12,12"/>
                        <components:LoadingSkeleton SkeletonWidth="150" SkeletonHeight="160"
                                                     SkeletonCornerRadius="12" Margin="0,0,12,12"/>
                        <components:LoadingSkeleton SkeletonWidth="150" SkeletonHeight="160"
                                                     SkeletonCornerRadius="12" Margin="0,0,12,12"/>
                    </WrapPanel>
                </StackPanel>

                <!-- Empty state -->
                <components:EmptyState Icon="FoodOff"
                                        Title="{StaticResource str_NoProductsFound}"
                                        Subtitle="{StaticResource str_NoResults}"
                                        Visibility="{Binding ShowEmptyProducts, Converter={StaticResource BoolToVisibility}}"/>

                <!-- Products grid -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding IsLoading, Converter={StaticResource InverseBoolToVisibility}}">
                    <ItemsControl ItemsSource="{Binding FilteredProducts}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- Product card -->
                                <Button Margin="0,0,10,10"
                                        Cursor="Hand"
                                        Command="{Binding DataContext.AddToCartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <Button.Template>
                                        <ControlTemplate>
                                            <Border x:Name="ProductCard"
                                                    Width="148" Height="160"
                                                    Background="{StaticResource CardBg}"
                                                    BorderBrush="{StaticResource DividerBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="12"
                                                    Padding="12"
                                                    RenderTransformOrigin="0.5,0.5">
                                                <Border.RenderTransform>
                                                    <TranslateTransform Y="0"/>
                                                </Border.RenderTransform>
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="*"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <!-- Stock badge (top right) -->
                                                    <Border Grid.Row="0"
                                                            HorizontalAlignment="Right"
                                                            CornerRadius="6"
                                                            Padding="6,2"
                                                            Background="{Binding Stock, Converter={StaticResource StatusToColor}}">
                                                        <TextBlock Text="{Binding Stock, Converter={StaticResource StockStatus}}"
                                                                   FontSize="9" FontWeight="Bold"
                                                                   Foreground="White"/>
                                                    </Border>

                                                    <!-- Product emoji -->
                                                    <TextBlock Grid.Row="0"
                                                               Text="{Binding Emoji}"
                                                               FontSize="32"
                                                               HorizontalAlignment="Left"
                                                               VerticalAlignment="Top"/>

                                                    <!-- Product name -->
                                                    <TextBlock Grid.Row="1"
                                                               Text="{Binding Name}"
                                                               FontSize="12" FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextPrimary}"
                                                               TextTrimming="CharacterEllipsis"
                                                               TextWrapping="Wrap"
                                                               MaxHeight="34"
                                                               VerticalAlignment="Bottom"
                                                               Margin="0,4,0,4"/>

                                                    <!-- Price -->
                                                    <TextBlock Grid.Row="2"
                                                               Text="{Binding Price, Converter={StaticResource CurrencyFormat}}"
                                                               FontSize="14" FontWeight="Bold"
                                                               Foreground="{StaticResource PrimaryBrush}"/>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ProductCard" Property="Background"
                                                            Value="{StaticResource CardHoverBg}"/>
                                                    <Setter TargetName="ProductCard" Property="BorderBrush"
                                                            Value="{StaticResource PrimaryBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- RIGHT PANEL — Cart / Order                                     -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <Border x:Name="ContentArea"
                Grid.Column="2"
                Background="{StaticResource CardBg}"
                BorderBrush="{StaticResource DividerBrush}"
                BorderThickness="1,0,0,0">
            <DockPanel>
                <!-- ── Order tabs ── -->
                <Border DockPanel.Dock="Top"
                        BorderBrush="{StaticResource DividerBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="8,8">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled">
                        <StackPanel Orientation="Horizontal">
                            <ItemsControl ItemsSource="{Binding OrderTabs}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Margin="0,0,4,0"
                                                Cursor="Hand"
                                                Command="{Binding DataContext.SwitchTabCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <Button.Template>
                                                <ControlTemplate>
                                                    <Border x:Name="TabBorder"
                                                            CornerRadius="8"
                                                            Padding="10,6"
                                                            Background="{StaticResource InputBg}"
                                                            BorderBrush="{StaticResource DividerBrush}"
                                                            BorderThickness="1">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding DisplayName}"
                                                                       FontSize="11" FontWeight="Medium"
                                                                       Foreground="{StaticResource TextSecondary}"
                                                                       VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding TotalDisplay}"
                                                                       FontSize="10"
                                                                       Foreground="{StaticResource TextMuted}"
                                                                       Margin="6,0,0,0"
                                                                       VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter TargetName="TabBorder" Property="Background"
                                                                    Value="{StaticResource PrimaryBrush}"/>
                                                            <Setter TargetName="TabBorder" Property="BorderBrush"
                                                                    Value="{StaticResource PrimaryBrush}"/>
                                                        </DataTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- New tab button -->
                            <Button Style="{StaticResource TitleBarButtonStyle}"
                                    Width="32" Height="32"
                                    Command="{Binding NewTabCommand}"
                                    ToolTip="{StaticResource str_NewTab}"
                                    Cursor="Hand"
                                    Margin="4,0,0,0">
                                <materialDesign:PackIcon Kind="Plus" Width="16" Height="16"
                                                         Foreground="{StaticResource TextMuted}"/>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- ── Customer selector ── -->
                <Border DockPanel.Dock="Top" Padding="12,8"
                        BorderBrush="{StaticResource DividerBrush}"
                        BorderThickness="0,0,0,1">
                    <ComboBox Style="{StaticResource DarkComboStyle}"
                              Height="36"
                              ItemsSource="{Binding Customers}"
                              SelectedItem="{Binding SelectedCustomer}"
                              DisplayMemberPath="Name"
                              materialDesign:HintAssist.Hint="{StaticResource str_SelectCustomer}"/>
                </Border>

                <!-- ── Action buttons (bottom) ── -->
                <Grid DockPanel.Dock="Bottom" Margin="12,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>  <!-- Coupon row -->
                        <RowDefinition Height="Auto"/>  <!-- Totals -->
                        <RowDefinition Height="Auto"/>  <!-- Buttons -->
                    </Grid.RowDefinitions>

                    <!-- Coupon input -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Style="{StaticResource DarkInputStyle}"
                                 Height="36" Padding="10,0"
                                 FontSize="12"
                                 Text="{Binding CouponCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="{StaticResource str_CouponCode}"/>
                        <Button Grid.Column="1"
                                Style="{StaticResource TitleBarButtonStyle}"
                                Width="Auto" Height="36"
                                Margin="8,0,0,0"
                                Command="{Binding ApplyCouponCommand}"
                                Cursor="Hand">
                            <StackPanel Orientation="Horizontal" Margin="8,0">
                                <materialDesign:PackIcon Kind="TicketPercent" Width="16" Height="16"
                                                         Foreground="{StaticResource PrimaryBrush}"
                                                         VerticalAlignment="Center"/>
                                <TextBlock Text="{StaticResource str_Apply}"
                                           FontSize="12" FontWeight="Medium"
                                           Foreground="{StaticResource PrimaryBrush}"
                                           Margin="6,0,0,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Totals section -->
                    <Border Grid.Row="1"
                            Background="{StaticResource InputBg}"
                            CornerRadius="10"
                            Padding="14,10"
                            Margin="0,0,0,12">
                        <StackPanel>
                            <!-- Subtotal -->
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="{StaticResource str_Subtotal}"
                                           FontSize="13" Foreground="{StaticResource TextSecondary}"
                                           HorizontalAlignment="Left"/>
                                <TextBlock Text="{Binding Subtotal, Converter={StaticResource CurrencyFormat}}"
                                           FontSize="13" Foreground="{StaticResource TextPrimary}"
                                           HorizontalAlignment="Right"/>
                            </Grid>

                            <!-- Discount (conditional) -->
                            <Grid Margin="0,0,0,6"
                                  Visibility="{Binding HasDiscount, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{StaticResource str_Discount}"
                                           FontSize="13" Foreground="{StaticResource SuccessBrush}"
                                           HorizontalAlignment="Left"/>
                                <TextBlock Text="{Binding DiscountDisplay}"
                                           FontSize="13" Foreground="{StaticResource SuccessBrush}"
                                           HorizontalAlignment="Right"/>
                            </Grid>

                            <!-- Tax -->
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="{StaticResource str_Tax}"
                                           FontSize="13" Foreground="{StaticResource TextSecondary}"
                                           HorizontalAlignment="Left"/>
                                <TextBlock Text="{Binding TaxAmount, Converter={StaticResource CurrencyFormat}}"
                                           FontSize="13" Foreground="{StaticResource TextPrimary}"
                                           HorizontalAlignment="Right"/>
                            </Grid>

                            <!-- Divider -->
                            <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,4"/>

                            <!-- Grand Total -->
                            <Grid Margin="0,6,0,0">
                                <TextBlock Text="{StaticResource str_GrandTotal}"
                                           FontSize="16" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimary}"
                                           HorizontalAlignment="Left"/>
                                <TextBlock Text="{Binding GrandTotal, Converter={StaticResource CurrencyFormat}}"
                                           FontSize="20" FontWeight="Bold"
                                           Foreground="{StaticResource PrimaryBrush}"
                                           HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Action buttons -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Hold Order -->
                        <Button Grid.Column="0"
                                Style="{StaticResource TitleBarButtonStyle}"
                                Width="Auto" Height="44"
                                Command="{Binding HoldOrderCommand}"
                                Cursor="Hand">
                            <StackPanel HorizontalAlignment="Center">
                                <materialDesign:PackIcon Kind="PauseCircleOutline" Width="20" Height="20"
                                                         Foreground="{StaticResource WarningBrush}"
                                                         HorizontalAlignment="Center"/>
                                <TextBlock Text="{StaticResource str_HoldOrder}"
                                           FontSize="10" FontWeight="Medium"
                                           Foreground="{StaticResource TextSecondary}"
                                           HorizontalAlignment="Center"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </Button>

                        <!-- Clear Cart -->
                        <Button Grid.Column="2"
                                Style="{StaticResource TitleBarButtonStyle}"
                                Width="Auto" Height="44"
                                Command="{Binding ClearCartCommand}"
                                Cursor="Hand">
                            <StackPanel HorizontalAlignment="Center">
                                <materialDesign:PackIcon Kind="DeleteOutline" Width="20" Height="20"
                                                         Foreground="{StaticResource ErrorBrush}"
                                                         HorizontalAlignment="Center"/>
                                <TextBlock Text="{StaticResource str_ClearCart}"
                                           FontSize="10" FontWeight="Medium"
                                           Foreground="{StaticResource TextSecondary}"
                                           HorizontalAlignment="Center"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </Button>

                        <!-- Pay button -->
                        <Button Grid.Column="4"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Height="44"
                                Command="{Binding PayCommand}"
                                Cursor="Hand">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <materialDesign:PackIcon Kind="CreditCardOutline" Width="20" Height="20"
                                                         Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{StaticResource str_Pay}"
                                           FontSize="15" FontWeight="Bold"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>

                <!-- ── Cart items list (center, scrollable) ── -->
                <Grid>
                    <!-- Empty cart state -->
                    <components:EmptyState Icon="CartOutline"
                                            Title="{StaticResource str_EmptyCart}"
                                            Subtitle="{StaticResource str_NoProductsFound}"
                                            Visibility="{Binding IsCartEmpty, Converter={StaticResource BoolToVisibility}}"/>

                    <!-- Cart items -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Visibility="{Binding IsCartEmpty, Converter={StaticResource InverseBoolToVisibility}}">
                        <ItemsControl ItemsSource="{Binding CartItems}" Margin="8,8">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource InputBg}"
                                            CornerRadius="10"
                                            Padding="10,8"
                                            Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Item info -->
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ProductName}"
                                                           FontSize="13" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimary}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding UnitPrice, Converter={StaticResource CurrencyFormat}}"
                                                           FontSize="11"
                                                           Foreground="{StaticResource TextMuted}"
                                                           Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <!-- Quantity controls -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                        VerticalAlignment="Center" Margin="8,0">
                                                <Button Style="{StaticResource TitleBarButtonStyle}"
                                                        Width="28" Height="28"
                                                        Command="{Binding DataContext.DecreaseQuantityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Cursor="Hand">
                                                    <materialDesign:PackIcon Kind="Minus" Width="14" Height="14"
                                                                             Foreground="{StaticResource TextSecondary}"/>
                                                </Button>
                                                <TextBlock Text="{Binding Quantity}"
                                                           FontSize="14" FontWeight="Bold"
                                                           Foreground="{StaticResource TextPrimary}"
                                                           VerticalAlignment="Center"
                                                           Margin="8,0"
                                                           MinWidth="20"
                                                           TextAlignment="Center"/>
                                                <Button Style="{StaticResource TitleBarButtonStyle}"
                                                        Width="28" Height="28"
                                                        Command="{Binding DataContext.IncreaseQuantityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Cursor="Hand">
                                                    <materialDesign:PackIcon Kind="Plus" Width="14" Height="14"
                                                                             Foreground="{StaticResource TextSecondary}"/>
                                                </Button>
                                            </StackPanel>

                                            <!-- Line total + remove -->
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center"
                                                        HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding LineTotal, Converter={StaticResource CurrencyFormat}}"
                                                           FontSize="13" FontWeight="Bold"
                                                           Foreground="{StaticResource TextPrimary}"
                                                           HorizontalAlignment="Right"/>
                                                <Button Style="{StaticResource TitleBarButtonStyle}"
                                                        Width="24" Height="20"
                                                        HorizontalAlignment="Right"
                                                        Command="{Binding DataContext.RemoveFromCartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Cursor="Hand"
                                                        Margin="0,2,0,0">
                                                    <materialDesign:PackIcon Kind="Close" Width="12" Height="12"
                                                                             Foreground="{StaticResource ErrorBrush}"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
