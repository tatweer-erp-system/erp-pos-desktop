<Window x:Class="TatweerPOS.Views.Dialogs.ManagerOverrideDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Width="420" Height="380"
        ResizeMode="NoResize"
        Loaded="Window_Loaded">

    <Window.Resources>
        <!-- PIN digit input style -->
        <Style x:Key="PinDigitStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource InputBg}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource InputBorder}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CaretBrush" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Width" Value="56"/>
            <Setter Property="Height" Value="56"/>
            <Setter Property="MaxLength" Value="1"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Focusable="false"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource InputBorderFocus}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Authorize button style -->
        <Style x:Key="AuthorizeButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Height" Value="42"/>
            <Setter Property="MinWidth" Value="110"/>
        </Style>

        <!-- Cancel button style -->
        <Style x:Key="OverrideCancelButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="MinWidth" Value="100"/>
            <Setter Property="Background" Value="{StaticResource CardHoverBg}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="20,0"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="scale" ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource InputBorder}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="scale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="0.96" Duration="0:0:0.1" AutoReverse="True"/>
                                            <DoubleAnimation Storyboard.TargetName="scale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="0.96" Duration="0:0:0.1" AutoReverse="True"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Semi-transparent overlay backdrop -->
    <Border Background="#CC000000">
        <Grid>
            <!-- Dialog card -->
            <Border x:Name="DialogCard"
                    Width="400" Height="360"
                    Background="{StaticResource SurfaceBg}"
                    CornerRadius="16"
                    RenderTransformOrigin="0.5,0.5"
                    Opacity="0">
                <Border.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform ScaleX="0.85" ScaleY="0.85"/>
                    </TransformGroup>
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="60" Opacity="0.6" ShadowDepth="0"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="56"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="70"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Border Grid.Row="0" Background="{StaticResource CardBg}" CornerRadius="16,16,0,0">
                        <Grid Margin="24,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="ShieldLockOutline"
                                                         Width="22" Height="22"
                                                         Foreground="{StaticResource WarningBrush}"
                                                         VerticalAlignment="Center"
                                                         Margin="0,0,10,0"/>
                                <TextBlock Text="{StaticResource str_ManagerOverride}"
                                           Foreground="{StaticResource TextPrimary}"
                                           FontSize="18" FontWeight="Bold"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource CloseButtonStyle}"
                                    Click="CancelButton_Click">
                                <materialDesign:PackIcon Kind="Close" Width="16" Height="16"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Content -->
                    <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="32,0">
                        <!-- Lock icon + auth message -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                            <materialDesign:PackIcon Kind="Lock"
                                                     Width="20" Height="20"
                                                     Foreground="{StaticResource WarningBrush}"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,8,0"/>
                            <TextBlock Text="{StaticResource str_ManagerAuthRequired}"
                                       Foreground="{StaticResource TextSecondary}"
                                       FontSize="13"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- Action description -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,20">
                            <TextBlock Text="{StaticResource str_Action}"
                                       Foreground="{StaticResource TextMuted}"
                                       FontSize="12" Margin="0,0,6,0"/>
                            <TextBlock x:Name="ActionDescriptionText"
                                       Foreground="{StaticResource TextPrimary}"
                                       FontSize="12" FontWeight="SemiBold"/>
                        </StackPanel>

                        <!-- Manager PIN label -->
                        <TextBlock Text="{StaticResource str_ManagerPin}"
                                   Foreground="{StaticResource TextSecondary}"
                                   FontSize="13"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,12"/>

                        <!-- 4 PIN input boxes -->
                        <StackPanel x:Name="PinContainer" Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    RenderTransformOrigin="0.5,0.5">
                            <StackPanel.RenderTransform>
                                <TranslateTransform x:Name="PinShakeTransform" X="0"/>
                            </StackPanel.RenderTransform>
                            <TextBox x:Name="Pin1" Style="{StaticResource PinDigitStyle}"
                                     Margin="0,0,10,0"
                                     TextChanged="PinDigit_TextChanged"
                                     PreviewTextInput="PinDigit_PreviewTextInput"
                                     KeyDown="PinDigit_KeyDown"/>
                            <TextBox x:Name="Pin2" Style="{StaticResource PinDigitStyle}"
                                     Margin="0,0,10,0"
                                     TextChanged="PinDigit_TextChanged"
                                     PreviewTextInput="PinDigit_PreviewTextInput"
                                     KeyDown="PinDigit_KeyDown"/>
                            <TextBox x:Name="Pin3" Style="{StaticResource PinDigitStyle}"
                                     Margin="0,0,10,0"
                                     TextChanged="PinDigit_TextChanged"
                                     PreviewTextInput="PinDigit_PreviewTextInput"
                                     KeyDown="PinDigit_KeyDown"/>
                            <TextBox x:Name="Pin4" Style="{StaticResource PinDigitStyle}"
                                     TextChanged="PinDigit_TextChanged"
                                     PreviewTextInput="PinDigit_PreviewTextInput"
                                     KeyDown="PinDigit_KeyDown"/>
                        </StackPanel>

                        <!-- Error message -->
                        <TextBlock x:Name="ErrorMessageText"
                                   Foreground="{StaticResource ErrorBrush}"
                                   FontSize="12"
                                   HorizontalAlignment="Center"
                                   Margin="0,12,0,0"
                                   Visibility="Collapsed"/>
                    </StackPanel>

                    <!-- Footer Buttons -->
                    <Border Grid.Row="2" Background="{StaticResource CardBg}" CornerRadius="0,0,16,16">
                        <Grid Margin="24,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button x:Name="CancelButton"
                                    Content="{StaticResource str_Cancel}"
                                    Style="{StaticResource OverrideCancelButtonStyle}"
                                    HorizontalAlignment="Left"
                                    Click="CancelButton_Click"/>

                            <Button x:Name="AuthorizeButton" Grid.Column="1"
                                    Content="{StaticResource str_Authorize}"
                                    Style="{StaticResource AuthorizeButtonStyle}"
                                    HorizontalAlignment="Right"
                                    IsEnabled="False"
                                    Click="AuthorizeButton_Click"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
