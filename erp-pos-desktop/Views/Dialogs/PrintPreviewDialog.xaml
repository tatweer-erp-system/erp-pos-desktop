<Window x:Class="TatweerPOS.Views.Dialogs.PrintPreviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Width="500" Height="700"
        ResizeMode="NoResize"
        Loaded="Window_Loaded">

    <Window.Resources>
        <!-- Footer button style -->
        <Style x:Key="DialogFooterButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinWidth" Value="100"/>
            <Setter Property="Background" Value="{StaticResource CardHoverBg}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="16,0"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="scale" ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ContentPresenter/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource InputBorder}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="scale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="0.96" Duration="0:0:0.1" AutoReverse="True"/>
                                            <DoubleAnimation Storyboard.TargetName="scale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="0.96" Duration="0:0:0.1" AutoReverse="True"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Semi-transparent overlay backdrop -->
    <Border Background="#CC000000">
        <Grid>
            <!-- Dialog card -->
            <Border x:Name="DialogCard"
                    Width="480" Height="680"
                    Background="{StaticResource SurfaceBg}"
                    CornerRadius="16"
                    RenderTransformOrigin="0.5,0.5"
                    Opacity="0">
                <Border.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform ScaleX="0.85" ScaleY="0.85"/>
                    </TransformGroup>
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="60" Opacity="0.6" ShadowDepth="0"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="56"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="70"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Border Grid.Row="0" Background="{StaticResource CardBg}" CornerRadius="16,16,0,0">
                        <Grid Margin="24,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="PrinterOutline"
                                                         Width="22" Height="22"
                                                         Foreground="{StaticResource PrimaryBrush}"
                                                         VerticalAlignment="Center"
                                                         Margin="0,0,10,0"/>
                                <TextBlock Text="{StaticResource str_PrintPreview}"
                                           Foreground="{StaticResource TextPrimary}"
                                           FontSize="18" FontWeight="Bold"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource CloseButtonStyle}"
                                    Click="CloseButton_Click">
                                <materialDesign:PackIcon Kind="Close" Width="16" Height="16"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Receipt Preview Area -->
                    <Border Grid.Row="1" Background="{StaticResource WindowBg}" Padding="24">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <Grid HorizontalAlignment="Center">
                                <!-- Paper strip -->
                                <Border Background="White"
                                        CornerRadius="4"
                                        Padding="24,28"
                                        MinWidth="280"
                                        MaxWidth="320">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" BlurRadius="20" Opacity="0.3" ShadowDepth="4"/>
                                    </Border.Effect>
                                    <TextBlock x:Name="ReceiptContent"
                                               FontFamily="Consolas, Courier New, monospace"
                                               FontSize="12"
                                               Foreground="#1A1A1A"
                                               TextWrapping="Wrap"
                                               LineHeight="18"
                                               Text=""/>
                                </Border>
                            </Grid>
                        </ScrollViewer>
                    </Border>

                    <!-- Footer Buttons -->
                    <Border Grid.Row="2" Background="{StaticResource CardBg}" CornerRadius="0,0,16,16">
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <Button Style="{StaticResource DialogFooterButtonStyle}"
                                    Margin="0,0,12,0"
                                    Click="ExportPDF_Click">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FilePdfBox" Width="18" Height="18"
                                                             Foreground="{StaticResource ErrorBrush}"
                                                             VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="{StaticResource str_ExportPDF}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Margin="0,0,12,0"
                                    Click="Print_Click">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                                        <Setter Property="Height" Value="40"/>
                                        <Setter Property="MinWidth" Value="100"/>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Printer" Width="18" Height="18"
                                                             Foreground="White"
                                                             VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="{StaticResource str_Print}" VerticalAlignment="Center"
                                               Foreground="White"/>
                                </StackPanel>
                            </Button>
                            <Button Content="{StaticResource str_Close}"
                                    Style="{StaticResource DialogFooterButtonStyle}"
                                    Click="CloseButton_Click"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Toast notification overlay -->
            <Border x:Name="ToastBorder"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,90"
                    Background="{StaticResource SuccessBrush}"
                    CornerRadius="8"
                    Padding="16,10"
                    Opacity="0"
                    IsHitTestVisible="False">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="CheckCircle" Width="18" Height="18"
                                             Foreground="White" VerticalAlignment="Center"
                                             Margin="0,0,8,0"/>
                    <TextBlock x:Name="ToastText" Foreground="White"
                               FontSize="13" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
